---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero/Hero.astro";
import PresenceIntro from "../components/sections/PresenceIntro/PresenceIntro.astro";
import About from "../components/sections/About/About.astro";
import WhoFor from "../components/sections/WhoFor/WhoFor.astro";
import FinalBridge from "../components/sections/FinalBridge/FinalBridge.astro";
import ProofPack from "../components/sections/ProofPack/ProofPack.astro";
import Testimonials from "../components/sections/Testimonials/Testimonials.astro";
import Footer from "../components/sections/Footer/Footer.astro";
---

<BaseLayout>
  <main id="main">
    <Hero />
    <PresenceIntro />

    <About />
    <ProofPack />
    <Testimonials />
    <WhoFor />
    <FinalBridge />

    <Footer showTopCta={false} />
  </main>
</BaseLayout>

