---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Work from "../../components/sections/Work/Work.astro";
import Footer from "../../components/sections/Footer/Footer.astro";

const title = "Sewing Ataga — Case Study · Kersivo";
const description =
  "How we designed and built Sewing Ataga's website — mobile-first, service-led, and built for local discovery. A full case study by Kersivo.";
---

<BaseLayout title={title} description={description}>
  <Work />
  <Footer showTopCta={false} />
</BaseLayout>

<script>
  // Fade in screenshot once loaded; keep fallback visible if it never loads
  const img = document.querySelector<HTMLImageElement>(".cs-browser__img");
  if (img) {
    if (img.complete && img.naturalWidth > 0) {
      img.classList.add("is-loaded");
    } else {
      img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
    }
  }
</script>
