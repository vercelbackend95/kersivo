---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Packages from "../../components/sections/Packages/Packages.astro";
import InlineContactLead from "../../components/sections/InlineContactLead/InlineContactLead.astro";
import Footer from "../../components/sections/Footer/Footer.astro";

const title = "Packages & Pricing — Kersivo";
const description =
  "Clear pricing for UK small businesses. Premium design, ruthless performance, SEO-ready builds. Pick a tier, get a quote.";
---

<BaseLayout title={title} description={description}>
