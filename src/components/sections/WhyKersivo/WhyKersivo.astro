---
import "./why-kersivo.css";

const differentiators = [
  {
    num: "01",
    tag: "Commercial clarity",
    title: "Conversion-led architecture.",
    text: "Every interface is structured around the decision journey, not just decoration. Proof, clarity, and next steps are built-in from the start, allowing users to move from discovery to enquiry with total confidence.",
    proof: ["Strategy-first structure", "Proof at every touchpoint", "Frictionless contact logic"],
  },
  {
    num: "02",
    tag: "Senior, founder-led delivery",
    title: "Direct execution, zero hand-offs.",
    text: "Strategy, design, and technical build are handled by a senior specialist from start to finish. This eliminates junior hand-offs and communication gaps, ensuring that the original vision is reflected perfectly in the final product.",
    proof: ["Single point of accountability", "Consistent quality control", "Transparent, direct process"],
  },
  {
    num: "03",
    tag: "Performance built in",
    title: "Fast by architecture, not by accident.",
    text: "Every build uses high-performance frameworks like Astro to deliver sub-second load times. The result is a system that scores exceptionally on Core Web Vitals and remains maintainable without technical overhead.",
    proof: ["Astro-first infrastructure", "Clean, lightweight code", "Low-maintenance reliability"],
  },
] as const;
---

<section
  class="ks-why section"
  id="why-kersivo"
  aria-labelledby="ks-why-heading"
  data-light-zone
  data-light-x="42"
  data-light-y="44"
  data-light-size="0.98"
  data-light-strength="0.7"
  data-light-focus="0.34"
>
  <div class="container ks-why__container">

    <header class="ks-why__head">
      <p class="k-kicker">Why clients choose Kersivo</p>
      <h2 class="ks-why__h2" id="ks-why-heading">
        Premium by feel. <em>Engineered for trust. Optimized for commerce.</em>
      </h2>
      <p class="ks-why__lead">
        Most digital solutions prioritize aesthetics over outcomes. Kersivo builds products that earn trust through performance, turning high-intent visitors into long-term clients.
      </p>
    </header>

    <div class="ks-why__ledger" role="list" aria-label="Why clients choose Kersivo">
      {differentiators.map((item) => (
        <article class="ks-why__row" role="listitem">
          <p class="ks-why__rowIndex" aria-hidden="true">{item.num}</p>

          <div class="ks-why__rowMain">
            <p class="ks-why__rowTag">{item.tag}</p>
            <h3 class="ks-why__rowTitle">{item.title}</h3>
          </div>

          <div class="ks-why__rowAside">
            <p class="ks-why__rowText">{item.text}</p>
            <div class="ks-why__proof" aria-label={`${item.tag} proof points`}>
              {item.proof.map((p) => (
                <span class="ks-why__proofItem">{p}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="ks-why__foot">
      <p class="ks-why__footNote">
        Typically selected for businesses that require a digital presence as professional as their service. Explore{" "}
        <a class="ks-why__footLink" href="/packages/">Packages &amp; Pricing</a>
        {" "}or{" "}
        <a class="ks-why__footLink" href="/work/barber-website-system/">View the Barber System</a>
        .
      </p>
    </div>

  </div>
</section>
