---
import "../../ui/CtaButton/cta-button.css";
import "./packages.css";
import PackagesTable from "./islands/PackagesTable";

// ✅ SEO: na landing = h2, na /packages = h1
const { asPage = false } = Astro.props;
const TitleTag = asPage ? "h1" : "h2";
const titleId = asPage ? "packages-page-title" : "packages-title";
---

<section id="packages" class="section k-packages" aria-labelledby={titleId} data-packages>
  <div class="container">
    <header class="k-pack__head">
      <p class="k-kicker k-pack__kicker">Packages</p>

      <TitleTag class="k-pack__title" id={titleId}>
        Transparent pricing.
        <span class="k-pack__grad">Measured by impact.</span>
      </TitleTag>

      <p class="k-pack__lead">
        From professional starter builds to integrated SaaS ecosystems. Select the foundation that matches the current scale and future objectives of the business.
      </p>

      <ul class="k-pack__meta" aria-label="Package standards">
        <li>UK Service Sector Focused</li>
        <li>Zero-bloat Performance</li>
        <li>Commercial Intent Logic</li>
      </ul>
    </header>

    <PackagesTable
      client:visible
      groupHeadingLevel={asPage ? 2 : 3}
      contactCtaHref={asPage ? "/packages/#contact" : "/#contact"}
    />
  </div>
</section>
