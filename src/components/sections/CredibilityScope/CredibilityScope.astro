---
import "./credibility-scope.css";

const engagements = [
  "Premium Web Development",
  "Niche SaaS Solutions",
  "Performance & SEO Builds",
] as const;
---

<section
  class="ks-cred section"
  id="credibility-scope"
  aria-labelledby="ks-cred-heading"
  data-light-zone
  data-light-x="46"
  data-light-y="43"
  data-light-size="0.96"
  data-light-strength="0.52"
  data-light-focus="0.4"
>
  <div class="container ks-cred__container">
    <header class="ks-cred__head">
      <p class="k-kicker">Methodology.</p>
      <h2 class="ks-cred__h2" id="ks-cred-heading">
        Built to perform. Demonstrated in detail.
      </h2>
      <p class="ks-cred__lead">
        Kersivo operates as a specialized product studio. Rather than maintaining a vast portfolio of generic websites, focus is placed on developing high-end, proprietary solutions—like the Kersivo Barber System. Every build is a live demonstration of technical standards, security, and conversion-first design.
      </p>
    </header>

    <ul class="ks-cred__grid" aria-label="How Kersivo scopes proof and fit">
      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Precision Builds</h3>
        <p class="ks-cred__cardText">
          Dedicated focus on niche SaaS applications and performance-led web infrastructure. Each project is engineered to solve specific operational bottlenecks, from booking automation to data sovereignty.
        </p>
        <ul class="ks-cred__tags" aria-label="Engagement types we take on">
          {engagements.map((label) => (
            <li class="ks-cred__tag">{label}</li>
          ))}
        </ul>
      </li>

      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Strategic Alignment</h3>
        <p class="ks-cred__cardText">
          Ideal for established UK service providers—specifically appointment-led businesses—where operational efficiency and high-quality enquiries are the primary objectives.
        </p>
      </li>

      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Live Demonstrations</h3>
        <p class="ks-cred__cardText">
          Full access to system environments and technical documentation is provided upon request. A direct walkthrough is the most effective way to evaluate how Kersivo technology aligns with specific business needs.
        </p>
      </li>
    </ul>
  </div>
</section>
