---
import "./credibility-scope.css";

const engagements = [
  "Website redesigns",
  "New site builds",
  "Performance & conversion passes",
] as const;
---

<section
  class="ks-cred section"
  id="credibility-scope"
  aria-labelledby="ks-cred-heading"
  data-light-zone
  data-light-x="46"
  data-light-y="43"
  data-light-size="0.96"
  data-light-strength="0.52"
  data-light-focus="0.4"
>
  <div class="container ks-cred__container">
    <header class="ks-cred__head">
      <p class="k-kicker">Proof in context</p>
      <h2 class="ks-cred__h2" id="ks-cred-heading">
        Curated in public. Clarified in conversation.
      </h2>
      <p class="ks-cred__lead">
        The case study on this page is there so you can follow a full engagement — structure,
        craft, and outcome — without guesswork. It is representative, not exhaustive. Additional
        live references, walkthroughs, and sector-relevant detail are shared when you enquire,
        matched to your brief and what is fair to show.
      </p>
    </header>

    <ul class="ks-cred__grid" aria-label="How Kersivo scopes proof and fit">
      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Engagement types</h3>
        <p class="ks-cred__cardText">
          Clear contracts around redesigns, new builds, and performance or conversion work — each
          with a defined outcome before we start.
        </p>
        <ul class="ks-cred__tags" aria-label="Engagement types we take on">
          {engagements.map((label) => (
            <li class="ks-cred__tag">{label}</li>
          ))}
        </ul>
      </li>

      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Typical fit</h3>
        <p class="ks-cred__cardText">
          We work best with established UK service businesses — creative and craft-led brands,
          local operators, and appointment-led models — where clarity, trust, and enquiry quality
          matter as much as aesthetics.
        </p>
      </li>

      <li class="ks-cred__card">
        <h3 class="ks-cred__cardTitle">Verification</h3>
        <p class="ks-cred__cardText">
          We do not use the site as a billboard of every client name. After a short introductory
          conversation, we share what helps you decide: live sites where appropriate, situational
          walkthroughs, or context under NDA when work is confidential.
        </p>
      </li>
    </ul>
  </div>
</section>
