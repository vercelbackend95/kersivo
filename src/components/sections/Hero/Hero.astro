---
import "./hero.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import Pill from "../../ui/Pill/Pill.astro";
---

<section class="k3-hero" aria-label="Kersivo hero">
  <div class="k3-wrap">
    <div class="k3-center">
      <div class="k3-badges" data-reveal>
        <span class="k3-badge">
          <span class="k3-badge__dot" aria-hidden="true"></span>
          Now booking for April–May 2026
        </span>
      </div>

      <h1 class="k3-h1" data-reveal>
        <span class="k3-line">Premium websites for UK small businesses</span>
        <span class="k3-line">built to <span class="k3-grad">earn trust</span></span>
        <span class="k3-line">and generate enquiries</span>

      </h1>

      <p class="k3-sub" data-reveal>
        Strategy-led design and development with clear scope, fast delivery, and a conversion-focused structure from day one.
      </p>

      <div class="k3-cta" data-reveal>
        <CtaButton href="/contact/#contact" label="Book a discovery call" variant="primary" />
        <CtaButton href="/work" label="View case studies" variant="ghost" magnetic={false} />
      </div>
      <p class="k3-cta-note" data-reveal>
        Start with a quick scope call, or review recent work first.
      </p>


      <div class="k-pills" data-reveal aria-label="Key benefits">
        <Pill label="Fast-loading pages" variant="accent" />
        <Pill label="Mobile-first UX" />
        <Pill label="SEO-ready foundations" />

      </div>
    </div>
  </div>

  <script>
    (() => {
      const hero = document.querySelector(".k3-hero");
      if (!hero) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const items = hero.querySelectorAll("[data-reveal]");
      if (items.length) hero.classList.add("k3-reveal");

      if (reduced) {
        items.forEach((el) => el.classList.add("is-in"));
            return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add("is-in");
              io.unobserve(en.target);
            }

          });
        },
        { threshold: 0.18 }
      );


      items.forEach((el, i) => {
        el.style.setProperty("--d", i * 75 + "ms");
        io.observe(el);

      });
    })();
  </script>
</section>
