---
import "./hero.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";
---

<section
  class="k3-hero"
  aria-label="Kersivo hero"
  data-light-zone
  data-light-x="53"
  data-light-y="17"
  data-light-size="1.1"
  data-light-strength="0.84"
  data-light-focus="0.22"
>
  <div class="container k3-hero__contain">
    <div class="k3-shell">
      <header class="k3-hero__head">
        <p class="k3-eyebrow">For established UK businesses</p>

        <h1 class="k3-h1">
          <span class="k3-line">Your website should look</span>
          <span class="k3-line"><span class="k3-em">as established</span></span>
          <span class="k3-line">as your business.</span>
        </h1>
      </header>

      <p class="k3-lead">
        Kersivo designs and builds websites for established UK businesses that need
        trust to land earlier and first impressions to match the level of the work.
      </p>

      <div class="k3-actions">
        <CtaButton
          href="/#contact"
          label="Ask for a quote"
          variant="primary"
          class="k3-primaryCta"
          magnetic={false}
          arrow={false}
        />

        <a class="k3-secondary" href="/work/">See selected work</a>
      </div>

      <footer class="k3-hero__foot">
        <div class="k3-proof" aria-label="Selected live proof">
          <span class="k3-proof__label">Selected live site</span>
          <a
            class="k3-proof__link"
            href="https://sewingataga.co.uk"
            target="_blank"
            rel="noreferrer"
          >
            Sewing Ataga
          </a>
        </div>

        <p class="k3-meta">
          <span>Booking April-May 2026</span>
          <span class="k3-meta__dot" aria-hidden="true">&middot;</span>
          <span>Replies within 12 hours</span>
        </p>
      </footer>
    </div>
  </div>
</section>
