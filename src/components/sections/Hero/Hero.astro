---
import "./hero.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const shiftSignals = [
  {
    label: "First impression",
    text: "Look more established from the first click.",
  },
  {
    label: "Trust",
    text: "Make the next step feel safer to take.",
  },
  {
    label: "Enquiries",
    text: "Pull in better-fit leads with clearer intent.",
  },
];
---

<section
  class="k3-hero"
  aria-label="Kersivo hero"
  data-light-zone
  data-light-x="54"
  data-light-y="18"
  data-light-size="1.14"
  data-light-strength="0.9"
  data-light-focus="0.26"
>
  <div class="container k3-shell">
    <div class="k3-copy">
      <div class="k3-meta" data-reveal>
        <p class="k3-kicker">Kersivo for UK small businesses</p>

        <div class="k3-availability" aria-label="Availability">
          <span class="k3-availability__dot" aria-hidden="true"></span>
          <span>Now booking April-May 2026</span>
        </div>
      </div>

      <h1 class="k3-h1" data-reveal>
        <span class="k3-line">When the website feels right,</span>
        <span class="k3-line">the business starts</span>
        <span class="k3-line"><span class="k3-em">getting treated differently.</span></span>
      </h1>

      <p class="k3-sub" data-reveal>
        Kersivo designs and builds websites for UK small businesses that have outgrown
        looking smaller than they are, so the first impression feels more established,
        trust lands earlier, and the right enquiries feel easier to send.
      </p>

      <aside class="k3-proof" data-reveal aria-label="Selected client note">
        <div class="k3-proof__top">
          <p class="k3-proof__eyebrow">Selected client note</p>
          <a
            class="k3-proof__link"
            href="https://sewingataga.co.uk"
            target="_blank"
            rel="noreferrer"
          >
            Live client site
          </a>
        </div>

        <blockquote class="k3-proof__quote">
          "Organised everything clearly, moved fast, and delivered a site that feels
          premium while still being practical for day-to-day enquiries."
        </blockquote>

        <div class="k3-proof__meta">
          <span class="k3-proof__name">Sewing Ataga</span>
          <span class="k3-proof__sep" aria-hidden="true"></span>
          <span class="k3-proof__role">Tailoring business, UK</span>
        </div>
      </aside>

      <div class="k3-actions" data-reveal>
        <CtaButton href="/contact/#contact" label="Ask for a quote" variant="primary" />

        <a class="k3-secondary" href="/work/">
          <span>See live work</span>
          <span aria-hidden="true">-></span>
        </a>
      </div>

      <p class="k3-response" data-reveal>
        Tell us what needs to change. We will reply within 12 hours.
      </p>
    </div>

    <div class="k3-stage" data-reveal aria-label="What changes when the site catches up">
      <div class="k3-stage__panel">
        <span class="k3-stage__wash" aria-hidden="true"></span>
        <span class="k3-stage__beam" aria-hidden="true"></span>
        <span class="k3-stage__grid" aria-hidden="true"></span>
        <span class="k3-stage__halo" aria-hidden="true"></span>

        <div class="k3-stage__intro">
          <p class="k3-stage__eyebrow">A stronger first impression</p>
          <p class="k3-stage__micro">
            The site stops introducing the business as a smaller version of itself.
          </p>
        </div>

        <div class="k3-stage__statement">
          <span>Look more established</span>
          <span class="k3-stage__statementAccent">before you have said a word.</span>
        </div>

        <div class="k3-stage__signals" role="list" aria-label="What changes">
          {shiftSignals.map((signal, index) => (
            <article
              class="k3-stage__signal"
              role="listitem"
              style={`--k3-shift:${index * 14}px;`}
            >
              <span class="k3-stage__signalIndex">{String(index + 1).padStart(2, "0")}</span>

              <div class="k3-stage__signalBody">
                <p class="k3-stage__signalLabel">{signal.label}</p>
                <p class="k3-stage__signalText">{signal.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const hero = document.querySelector(".k3-hero");
      if (!hero) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const items = hero.querySelectorAll("[data-reveal]");
      if (items.length) hero.classList.add("k3-reveal");

      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-in"));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      items.forEach((el, index) => {
        el.style.setProperty("--d", `${index * 85}ms`);
        io.observe(el);
      });
    })();
  </script>
</section>
