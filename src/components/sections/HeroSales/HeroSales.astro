---
import "./hero-sales.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import { CTA_PRIMARY_CONTACT, CTA_SECONDARY_WORK } from "../../../site/cta";

const trustPoints = [
  "Built for the UK",
  "Reply within 12 working hours",
  "Direct Founder Access",
] as const;
---

<section
  class="ks-hero"
  aria-label="Kersivo — hero"
  data-light-zone
  data-light-x="53"
  data-light-y="17"
  data-light-size="1.1"
  data-light-strength="0.84"
  data-light-focus="0.22"
>
  <div class="container ks-hero__contain">
    <div class="ks-hero__shell">

      <p class="ks-eyebrow">
        <span class="ks-eyebrow__dot" aria-hidden="true"></span>
        Premium Web Design &amp; Development for Established UK Service Businesses.
      </p>

      <h1 class="ks-h1">
        <span class="ks-h1__line">Performance-led websites &amp; custom SaaS tools for UK service businesses.</span>
        <span class="ks-h1__line"><span class="ks-h1__em">No agencies, no middlemen—just direct expert results.</span></span>
      </h1>

      <p class="ks-lead">
        Premium, performance-first digital products that improve trust, clarity,
        and enquiry quality for UK service businesses.
      </p>

      <div class="ks-actions">
        <CtaButton
          href="/#contact"
          label={CTA_PRIMARY_CONTACT}
          variant="primary"
          class="ks-cta-primary"
          magnetic={false}
          arrow={true}
        />
        <CtaButton
          href="/work/"
          label={CTA_SECONDARY_WORK}
          variant="secondary"
          class="ks-cta-secondary"
          magnetic={false}
          arrow={true}
        />
      </div>

      <ul class="ks-trust" aria-label="Contact confidence signals" role="list">
        {trustPoints.map((point) => (
          <li class="ks-trust__item">{point}</li>
        ))}
      </ul>

    </div>
  </div>
</section>
