---
import "./process-lite.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import { CTA_SECONDARY_PACKAGES, CTA_SECONDARY_WORK } from "../../../site/cta";

const steps = [
  {
    num: "01",
    title: "Strategy & Alignment",
    text: "Deep analysis of business goals, audience behavior, and conversion barriers. This phase defines the technical roadmap before a single line of code is written.",
    items: ["Objective setting", "Positioning & offer clarity", "Conversion mapping"],
  },
  {
    num: "02",
    title: "Engineering & Performance",
    text: "Development of a premium visual system engineered for performance. Built mobile-first using Astro, ensuring sub-second load times and a frictionless user experience.",
    items: ["High-fidelity UI design", "Astro-first development", "Rigorous performance testing"],
  },
  {
    num: "03",
    title: "Deployment & Handover",
    text: "Production launch following a comprehensive quality checklist. Every project is handed over with full documentation and the practical support needed for long-term maintenance.",
    items: ["Production-ready QA", "Complete Handover Passport", "Post-launch technical support"],
  },
] as const;
---

<section
  class="ks-process section"
  id="process-overview"
  aria-labelledby="ks-process-heading"
  data-light-zone
  data-light-x="50"
  data-light-y="46"
  data-light-size="0.96"
  data-light-strength="0.56"
  data-light-focus="0.38"
>
  <div class="container ks-process__container">

    <header class="ks-process__head">
      <p class="k-kicker">How we work</p>
      <h2 class="ks-process__h2" id="ks-process-heading">
        A structured workflow. Zero technical friction.
      </h2>
      <p class="ks-process__lead">
        Three defined phases from brief to deployment — ensuring transparency, speed, and a high-performance outcome.
      </p>
    </header>

    <ol class="ks-process__steps" aria-label="Our process steps">
      {steps.map((step) => (
        <li class="ks-process__step">
          <div class="ks-process__stepTop">
            <span class="ks-process__stepNum" aria-hidden="true">{step.num}</span>
            <h3 class="ks-process__stepTitle">{step.title}</h3>
          </div>
          <p class="ks-process__stepText">{step.text}</p>
          <ul class="ks-process__stepItems" aria-label={`${step.title} deliverables`}>
            {step.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

    <div class="ks-process__foot">
      <div class="ks-process__ctas" role="group" aria-label="Explore pricing and work">
        <CtaButton
          href="/packages/"
          label={CTA_SECONDARY_PACKAGES}
          variant="secondary"
          arrow={true}
          magnetic={false}
        />
        <CtaButton
          href="/work/"
          label={CTA_SECONDARY_WORK}
          variant="secondary"
          arrow={true}
          magnetic={false}
        />
      </div>
      <p class="ks-process__footNote">
        Project availability is limited to ensure direct focus on every build. Reach out via the contact section for a technical walkthrough.
      </p>
    </div>

  </div>
</section>
