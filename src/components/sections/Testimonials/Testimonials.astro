---
import "./testimonials.css";

type ClientNote = {
  quote: string;
  name: string;
  role: string;
  context?: string;
};

type TrustSignal = {
  label: string;
  title: string;
  text: string;
};

interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  reference?: string;
  noteLabel?: string;
  note?: ClientNote;
  standardsEyebrow?: string;
  standardsTitle?: string;
  standardsIntro?: string;
  signals?: TrustSignal[];
}

const {
  kicker = "WORKING STANDARD",
  title = "The studio is early. The standard is not.",
  subtitle =
    "Selected feedback, backed by the things that actually build trust: fast mobile performance, conversion-aware structure, clean implementation, and a calm delivery process.",
  reference = "Live reference: sewingataga.co.uk",
  noteLabel = "Selected client note",
  note = {
    quote:
      "Kersivo organised everything clearly, moved fast, and delivered a website that feels premium while still being practical for day-to-day enquiries.",
    name: "Sewing Ataga",
    role: "Tailoring business, UK",
    context: "Live client website",
  },
  standardsEyebrow = "Trust signals",
  standardsTitle = "How the work earns confidence.",
  standardsIntro =
    "This is the layer beneath the visual finish: build quality, page logic, and a delivery process that stays clear from scope to launch.",
  signals = [
    {
      label: "Performance-first",
      title: "Fast where it matters.",
      text:
        "Astro-first builds, lean assets, and restrained motion keep the site feeling sharp on mobile and on slower connections.",
    },
    {
      label: "Mobile-first thinking",
      title: "The primary journey starts on a phone.",
      text:
        "Layout, hierarchy, and contact prompts are designed around the screen most service-business visitors actually use.",
    },
    {
      label: "Conversion-aware structure",
      title: "Each section has a job to do.",
      text:
        "Offer clarity, proof, and next steps are placed deliberately so the site helps the right visitor move to enquiry faster.",
    },
    {
      label: "Clean implementation",
      title: "Premium finish without future mess.",
      text:
        "Readable code, tidy handover, and a straightforward feedback rhythm keep the site easy to maintain after launch.",
    },
  ],
} = Astro.props as Props;
---

<section
  id="reviews"
  class="section k-reviews"
  data-section
  data-light-zone
  data-light-x="58"
  data-light-y="44"
  data-light-size="0.96"
  data-light-strength="0.62"
  data-light-focus="0.34"
>
  <div class="container">
    <header class="k-reviews__head sectionTitle">
      <div class="k-reviews__titles">
        <h6>{kicker}</h6>
        <h2>{title}</h2>
        <p class="k-reviews__sub measure">{subtitle}</p>
      </div>

      <div class="k-reviews__note" aria-label="Live project reference">
        <span class="k-reviews__noteDot"></span>
        <span>{reference}</span>
      </div>
    </header>

    <div class="k-reviews__grid">
      <article class="k-reviews__card k-reviews__card--note" aria-labelledby="client-note-heading">
        <div class="k-reviews__cardMeta">
          <p class="k-reviews__eyebrow">{noteLabel}</p>
          {note.context && <span class="k-reviews__pill">{note.context}</span>}
        </div>

        <blockquote class="k-reviews__quote">
          <span class="k-reviews__quoteMark" aria-hidden="true">"</span>
          <p id="client-note-heading">{note.quote}</p>
        </blockquote>

        <footer class="k-reviews__client">
          <div class="k-reviews__clientIdentity">
            <span class="k-reviews__clientName">{note.name}</span>
            <span class="k-reviews__clientRole">{note.role}</span>
          </div>

          <span class="k-reviews__clientSeal">Selected feedback</span>
        </footer>
      </article>

      <article class="k-reviews__card k-reviews__card--standards" aria-labelledby="trust-signals-heading">
        <div class="k-reviews__standardsHead">
          <p class="k-reviews__eyebrow">{standardsEyebrow}</p>
          <h3 id="trust-signals-heading">{standardsTitle}</h3>
          <p>{standardsIntro}</p>
        </div>

        <div class="k-reviews__signals" role="list" aria-label="Trust signals">
          {signals.map((signal, index) => (
            <article class="k-reviews__signal" role="listitem">
              <div class="k-reviews__signalIndex" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="k-reviews__signalBody">
                <p class="k-reviews__signalLabel">{signal.label}</p>
                <h4 class="k-reviews__signalTitle">{signal.title}</h4>
                <p class="k-reviews__signalText">{signal.text}</p>
              </div>
            </article>
          ))}
        </div>
      </article>
    </div>
  </div>
</section>
