---
import "./testimonials.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";

type ClientProof = {
  quote: string;
  name: string;
  role: string;
  context: string;
};

type SnapshotItem = {
  label: string;
  value: string;
};

type ExpectationItem = {
  title: string;
  text: string;
};

type ProcessStep = {
  title: string;
  text: string;
};

interface Props {
  label?: string;
  title?: string;
  subtitle?: string;
  quoteLabel?: string;
  clientProof?: ClientProof;
  snapshotTitle?: string;
  snapshot?: SnapshotItem[];
  expectationsTitle?: string;
  expectations?: ExpectationItem[];
  processTitle?: string;
  process?: ProcessStep[];
  ctaLabel?: string;
  ctaHref?: string;
  ctaNote?: string;
}

const {
  label = "Client Proof",
  title = "Proof, not promises.",
  subtitle =
    "Real feedback from a real client, plus the exact standards used on every project. Clear process, senior execution, and measurable business intent.",
  quoteLabel = "Verified client feedback",
  clientProof = {
    quote:
      "Kersivo helped us turn a confusing website into a clear sales asset. The process was structured, communication was excellent, and the final result felt premium from both a design and performance perspective.",
    name: "Sewing Ataga",
    role: "Founder",
    context: "Tailoring business, UK",
  },
  snapshotTitle = "Project snapshot",
  snapshot = [
    {
      label: "Industry",
      value: "Local tailoring service, UK",
    },
    {
      label: "Scope",
      value: "Offer clarity, UX/UI design, and Astro development",
    },
    {
      label: "Outcome",
      value:
        "Clearer service communication, stronger enquiry intent, and a faster launch with less delivery friction",
    },
  ],
  expectationsTitle = "What clients can expect every time",
  expectations = [
    {
      title: "Founder-led delivery",
      text:
        "Direct involvement from strategy through final QA keeps quality and ownership consistent.",
    },
    {
      title: "Mobile-first, performance-conscious builds",
      text:
        "The primary user journey is designed for phone screens, then refined for larger devices.",
    },
    {
      title: "Transparent scope and timelines",
      text:
        "No hidden steps, no vague handoffs, and clear checkpoints from discovery to launch.",
    },
  ],
  processTitle = "How we deliver",
  process = [
    {
      title: "Discover",
      text: "Define goals, audience priorities, and conversion direction before design starts.",
    },
    {
      title: "Design",
      text: "Shape a premium visual system and page structure around real business intent.",
    },
    {
      title: "Build and refine",
      text:
        "Develop for speed, polish, and maintainability with practical handover-ready output.",
    },
  ],
  ctaLabel = "Book a 30-minute discovery call",
  ctaHref = "/#contact",
  ctaNote = "No pressure, no hard sell. You leave with a clear next-step direction.",
} = Astro.props as Props;
---

<section
  id="reviews"
  class="section k-reviews"
  data-section
  data-light-zone
  data-light-x="58"
  data-light-y="44"
  data-light-size="0.96"
  data-light-strength="0.62"
  data-light-focus="0.34"
>
  <div class="container">
    <header class="k-reviews__head sectionTitle">
      <div class="k-reviews__titles">
        <h6>{label}</h6>
        <h2>{title}</h2>
        <p class="k-reviews__sub measure">{subtitle}</p>
      </div>
    </header>

    <div class="k-reviews__grid">
      <article class="k-reviews__card k-reviews__card--quote" aria-labelledby="client-proof-heading">
        <div class="k-reviews__cardHead">
          <p class="k-reviews__eyebrow">{quoteLabel}</p>
          <span class="k-reviews__pill">{clientProof.context}</span>
        </div>

        <blockquote class="k-reviews__quote">
          <span class="k-reviews__quoteMark" aria-hidden="true">"</span>
          <p id="client-proof-heading">{clientProof.quote}</p>
        </blockquote>

        <footer class="k-reviews__client">
          <div class="k-reviews__clientIdentity">
            <span class="k-reviews__clientName">{clientProof.name}</span>
            <span class="k-reviews__clientRole">{clientProof.role}</span>
          </div>
          <span class="k-reviews__clientSeal">Verified project feedback</span>
        </footer>
      </article>

      <article class="k-reviews__card k-reviews__card--snapshot" aria-labelledby="project-snapshot-heading">
        <div class="k-reviews__snapshotHead">
          <p class="k-reviews__eyebrow">Evidence context</p>
          <h3 id="project-snapshot-heading">{snapshotTitle}</h3>
        </div>
        <dl class="k-reviews__snapshotList">
          {snapshot.map((item) => (
            <div class="k-reviews__snapshotRow">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </article>
    </div>

    <div class="k-reviews__lower">
      <article class="k-reviews__card k-reviews__card--expectations" aria-labelledby="expectations-heading">
        <div class="k-reviews__expectationsHead">
          <p class="k-reviews__eyebrow">Delivery standards</p>
          <h3 id="expectations-heading">{expectationsTitle}</h3>
        </div>

        <div class="k-reviews__expectations" role="list" aria-label="Delivery standards">
          {expectations.map((item, index) => (
            <article class="k-reviews__expectation" role="listitem">
              <div class="k-reviews__expectationIndex" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </div>
              <div class="k-reviews__expectationBody">
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </div>
            </article>
          ))}
        </div>
      </article>

      <article class="k-reviews__card k-reviews__card--process" aria-labelledby="delivery-process-heading">
        <div class="k-reviews__processHead">
          <p class="k-reviews__eyebrow">Execution clarity</p>
          <h3 id="delivery-process-heading">{processTitle}</h3>
        </div>

        <ol class="k-reviews__processList">
          {process.map((step) => (
            <li class="k-reviews__processStep">
              <h4>{step.title}</h4>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </article>
    </div>

    <div class="k-reviews__ctaWrap">
      <CtaButton href={ctaHref} label={ctaLabel} variant="primary" />
      <p class="k-reviews__ctaNote">{ctaNote}</p>
    </div>
  </div>
</section>
