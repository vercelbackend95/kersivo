---
import "./testimonials-new.css";
---

<section
  class="ks-testi section"
  id="testimonials"
  aria-labelledby="ks-testi-quote"
  data-light-zone
  data-light-x="48"
  data-light-y="44"
  data-light-size="1.02"
  data-light-strength="0.66"
  data-light-focus="0.32"
>
  <div class="container ks-testi__container">

    <p class="k-kicker">Client voice</p>

    <div class="ks-testi__body">

      <!-- LEFT: quote -->
      <div class="ks-testi__quoteCol">
        <p class="ks-testi__mark" aria-hidden="true">&ldquo;</p>

        <blockquote class="ks-testi__quote" id="ks-testi-quote">
          Kersivo delivered exactly what they promised. The site is fast,
          clear, and the quality of people who get in touch has improved
          noticeably. <em>It now feels like a business I'm proud to send
          people to.</em>
        </blockquote>

        <div class="ks-testi__attr">
          <div class="ks-testi__attrRow">
            <div class="ks-testi__avatar" aria-hidden="true">
              <span class="ks-testi__avatarInitials">JC</span>
            </div>
            <div class="ks-testi__name">
              <p class="ks-testi__who">Jane Collins</p>
              <p class="ks-testi__role">Owner — Sewing Ataga</p>
            </div>
          </div>

          <a
            class="ks-testi__projectLink"
            href="https://sewingataga.co.uk"
            target="_blank"
            rel="noreferrer"
            aria-label="View Sewing Ataga live site (opens in new tab)"
          >
            View live project — sewingataga.co.uk
            <svg viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.5 9.5l7-7M8 2.5h2.5v2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- RIGHT: project mockup -->
      <div class="ks-testi__mockupCol">
        <figure class="ks-testi__mockupWrap" aria-label="Sewing Ataga website — built by Kersivo" role="img">

          <!-- browser chrome -->
          <div class="ks-testi__bar" aria-hidden="true">
            <span class="ks-testi__dot"></span>
            <span class="ks-testi__dot"></span>
            <span class="ks-testi__dot"></span>
            <div class="ks-testi__urlbar">
              <svg class="ks-testi__lock" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="8" height="6" rx="1.2" stroke="currentColor" stroke-width="1.2"/>
                <path d="M4 5V3.5a2 2 0 0 1 4 0V5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
              <span class="ks-testi__url">sewingataga.co.uk</span>
            </div>
          </div>

          <!-- simulated page content -->
          <div class="ks-testi__content" aria-hidden="true">

            <nav class="ks-testi__contentNav">
              <span class="ks-testi__contentNavItem">Home</span>
              <span class="ks-testi__contentNavItem">Services</span>
              <span class="ks-testi__contentNavItem">Gallery</span>
              <span class="ks-testi__contentNavItem">Contact</span>
            </nav>

            <div class="ks-testi__contentHero">
              <p class="ks-testi__contentLabel">Bespoke tailoring · London</p>
              <p class="ks-testi__contentH">Tailoring that fits perfectly.</p>
              <p class="ks-testi__contentSub">
                Premium alterations and bespoke garments for discerning clients in London and beyond.
              </p>
              <div class="ks-testi__contentCtaRow">
                <span class="ks-testi__contentCta">Book a fitting →</span>
                <span class="ks-testi__contentCtaGhost">View gallery</span>
              </div>
            </div>

            <div class="ks-testi__scores">
              <div class="ks-testi__score">
                <span class="ks-testi__scoreNum">98</span>
                <span class="ks-testi__scoreLabel">Performance</span>
              </div>
              <div class="ks-testi__score">
                <span class="ks-testi__scoreNum">100</span>
                <span class="ks-testi__scoreLabel">Accessibility</span>
              </div>
              <div class="ks-testi__score">
                <span class="ks-testi__scoreNum">100</span>
                <span class="ks-testi__scoreLabel">Best Practices</span>
              </div>
            </div>

          </div>
        </figure>

        <!-- floating badge -->
        <div class="ks-testi__badge" aria-hidden="true">
          <span class="ks-testi__badgeDot"></span>
          <span class="ks-testi__badgeText">Live project · sewingataga.co.uk</span>
        </div>
      </div>

    </div>
  </div>
</section>
