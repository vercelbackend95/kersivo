---
import "./final-bridge.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const contactEmail = "hello@kersivo.co.uk";

const replyShape = [
  {
    idx: "01",
    label: "Fit",
    text: "A direct read on whether the timing, chemistry, and commercial shape line up — for you and for us.",
  },
  {
    idx: "02",
    label: "Scope",
    text: "A grounded view of what the site likely needs so value lands earlier — without padding the build.",
  },
  {
    idx: "03",
    label: "Route",
    text: "A clear next move: quote, a short call, or permission to pause if the moment is not right yet.",
  },
];
---

<section
  class="k-turn section"
  id="turning-point"
  aria-label="How to begin an enquiry with Kersivo"
  data-light-zone
  data-light-x="56"
  data-light-y="48"
  data-light-size="1"
  data-light-strength="0.64"
  data-light-focus="0.36"
>
  <div class="container k-turn__container">
    <div class="k-turn__rail" aria-hidden="true"></div>

    <div class="k-turn__stack">
      <header class="k-turn__mast" data-turn-reveal style="--turn-delay: 0ms;">
        <p class="k-turn__eyebrow">When you're ready</p>

        <h2 class="k-turn__title">
          One short note is enough for a straight answer on fit, scope, and what follows.
        </h2>

        <p class="k-turn__lead">
          Send your live site, what is holding trust back, and any timing that matters. We reply
          within 12 hours with a clear take — even when the honest answer is to wait.
        </p>
      </header>

      <ol class="k-turn__matrix" aria-label="What the first reply includes">
        {
          replyShape.map((row, i) => (
            <li class="k-turn__row" data-turn-reveal style={`--turn-delay: ${80 + i * 72}ms;`}>
              <span class="k-turn__idx" aria-hidden="true">
                {row.idx}
              </span>
              <div class="k-turn__rowBody">
                <p class="k-turn__rowLabel">{row.label}</p>
                <p class="k-turn__rowText">{row.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="k-turn__ctaBand" data-turn-reveal style="--turn-delay: 320ms;">
        <div class="k-turn__ctaTop">
          <p class="k-turn__promise">No pitch theatre. No follow-up spam.</p>
          <p class="k-turn__micro">
            The contact form keeps context in one place — or write directly if you prefer.
          </p>
        </div>

        <div class="k-turn__ctaActions">
          <CtaButton
            href="/contact/#contact"
            label="Continue to the contact page"
            variant="primary"
            magnetic={false}
            arrow={false}
            class="k-turn__cta"
          />

          <a class="k-turn__mail" href={`mailto:${contactEmail}`}>
            <span class="k-turn__mailK">Direct email</span>
            <span class="k-turn__mailV">{contactEmail}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("#turning-point");
      if (!root) return;

      const revealItems = Array.from(root.querySelectorAll("[data-turn-reveal]"));
      if (!revealItems.length) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      revealItems.forEach((item, index) => {
        if (!item.style.getPropertyValue("--turn-delay")) {
          item.style.setProperty("--turn-delay", `${index * 100}ms`);
        }
      });

      if (reduced || !("IntersectionObserver" in window)) {
        root.classList.add("is-revealed");
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            root.classList.add("is-revealed");
            observer.disconnect();
          });
        },
        { threshold: 0.18, rootMargin: "0px 0px -6% 0px" }
      );

      observer.observe(root);
    })();
  </script>
</section>
