---
import "./work-index.css";

type Entry = {
  kind: string;
  href: string;
  /** Omit when no public screenshot yet — a branded placeholder is shown. */
  imageSrc?: string;
  /** Required when `imageSrc` is set. */
  imageAlt?: string;
  title: string;
  meta: string;
  summary: string;
  cta: string;
};

const entries: Entry[] = [
  {
    kind: "Client project",
    href: "/work/sewing-ataga/",
    imageSrc: "/screenshots/sewing-ataga-desktop.jpg",
    imageAlt: "Sewing Ataga website preview showing premium tailoring service homepage",
    title: "Sewing Ataga",
    meta: "Tailoring & alterations — Poole, UK",
    summary:
      "High-performance web infrastructure for a London-based tailoring studio. Focused on local SEO foundations and a frictionless mobile journey to drive high-intent enquiries.",
    cta: "Read case study",
  },
  {
    kind: "Studio product · Live demo",
    href: "/work/barber-website-system/",
    imageSrc: "/screenshots/barber-system-desktop.jpg",
    imageAlt: "Barber website system preview with booking and retail interface",
    title: "Kersivo Barber System",
    meta: "Bookings, retail & admin — UK barbershops",
    summary:
      "An end-to-end booking and retail ecosystem designed for UK barbershops. Built with Astro for sub-second speeds, featuring automated scheduling, data sovereignty, and a zero-friction checkout.",
    cta: "Explore product demo",
  },
  {
    kind: "New SaaS (Coming Soon)",
    href: "/contact/",
    title: "Consultancy Booking Engine",
    meta: "In Development — Q3 2026",
    summary:
      "A high-integrity scheduling platform for professional service providers. Replacing back-and-forth emails with automated, prepay-enabled consultation booking and secure client portals.",
    cta: "Register interest",
  },
];
---

<section class="wk-index section" aria-labelledby="wk-index-title">
  <div class="container">
    <header class="wk-index__head">
      <p class="k-kicker k-kicker--md wk-index__eyebrow">Product Lab</p>
      <h1 class="wk-index__title" id="wk-index-title">Evidence, curated.</h1>
      <p class="wk-index__lead">
        A focused display of public deployments — comprising active client engagements and proprietary studio
        products. The portfolio is kept small by design; focus is placed on depth of integration and technical
        performance rather than project volume.
      </p>
    </header>

    <ul class="wk-index__list" role="list">
      {
        entries.map((item, i) => (
          <li class="wk-index__item">
            <a class="wk-card" href={item.href}>
              <figure
                class:list={[
                  "wk-card__media",
                  !item.imageSrc && "wk-card__media--placeholder",
                ]}
              >
                {item.imageSrc ? (
                  <img
                    class="wk-card__img"
                    src={item.imageSrc}
                    alt={item.imageAlt}
                    width="1200"
                    height="760"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div
                    class="wk-card__placeholder"
                    role="img"
                    aria-label="New SaaS (coming soon); product preview image not yet available"
                  >
                    <span class="wk-card__placeholderMark" aria-hidden="true">New SaaS (Coming Soon)</span>
                  </div>
                )}
              </figure>
              <div class="wk-card__body">
                <span class="wk-card__row">
                  <span class="wk-card__index" aria-hidden="true">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="wk-card__kind">{item.kind}</span>
                </span>
                <h2 class="wk-card__title">{item.title}</h2>
                <p class="wk-card__meta">{item.meta}</p>
                <p class="wk-card__summary">{item.summary}</p>
                <span class="wk-card__cta">
                  <span class="wk-card__ctaLabel">{item.cta}</span>
                  <span class="wk-card__ctaArrow" aria-hidden="true">
                    &#8594;
                  </span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="wk-index__note" role="note">
      Confidential builds and internal enterprise tools are not listed publicly. For sector-specific proof
      (e.g., hospitality, professional services) or technical walkthroughs under NDA — please enquire directly.
    </p>
  </div>
</section>
