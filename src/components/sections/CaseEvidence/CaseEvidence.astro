---
import "./case-evidence.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const steps = [
  {
    key: "problem",
    label: "The problem",
    badge: "01",
    title: "Fragmentation and third-party dependency.",
    text: "Many service-based businesses rely on fragmented tools or dated platforms that erode brand trust. For barbershops, using generic booking apps often means high commission fees and a total lack of control over the customer journey and sensitive data.",
  },
  {
    key: "change",
    label: "The solution",
    badge: "02",
    title: "Precision-engineered booking infrastructure.",
    text: "Implementation of a high-performance booking engine built with Astro for sub-second load times. The architecture prioritises a frictionless mobile-first UI, sharpened service messaging, and a robust backend designed to handle real-time scheduling without third-party interference.",
  },
  {
    key: "outcome",
    label: "The outcome",
    badge: "03",
    title: "Operational autonomy and higher enquiry intent.",
    text: "The transition to a dedicated system ensures that first impressions match the premium quality of the service provided. By removing external distractions, the platform drives stronger booking intent, clearer business positioning, and full ownership of the client relationship.",
  },
] as const;
---

<section
  class="ks-case section"
  id="case-evidence"
  aria-labelledby="ks-case-heading"
  data-light-zone
  data-light-x="44"
  data-light-y="42"
  data-light-size="1.02"
  data-light-strength="0.62"
  data-light-focus="0.36"
>
  <div class="container ks-case__container">

    <header class="ks-case__head">
      <p class="k-kicker">Specialist Solution</p>
      <p class="ks-case__anchor">
        Featured Deployment: <strong class="ks-case__clientName">High-Performance Booking Ecosystem for Barbershops</strong>.
      </p>
      <h2 class="ks-case__h2" id="ks-case-heading">
        Replacing third-party dependencies with custom-built autonomy.
      </h2>
    </header>

    <div class="ks-case__steps" role="list" aria-label="Case study stages">
      {steps.map((step) => (
        <article class={`ks-case__step ks-case__step--${step.key}`} role="listitem">
          <p class="ks-case__stepLabel">
            <span class="ks-case__stepBadge" aria-hidden="true">{step.badge}</span>
            {step.label}
          </p>
          <h3 class="ks-case__stepTitle">{step.title}</h3>
          <p class="ks-case__stepText">{step.text}</p>
        </article>
      ))}
    </div>

    <div class="ks-case__foot">
      <CtaButton
        href="/work/sewing-ataga/"
        label="See full case study"
        variant="secondary"
        arrow={true}
        magnetic={false}
      />
    </div>

  </div>
</section>
