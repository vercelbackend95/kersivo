---
import "./turning-point.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const contactEmail = "hello@kersivo.co.uk";

const enquiryOutcomes = [
  {
    label: "Fit",
    text: "Whether Kersivo is the right match for the business and the stage you are at.",
  },
  {
    label: "Scope",
    text: "What the website likely needs to do properly, without padding the project out.",
  },
  {
    label: "Next step",
    text: "A clear route into a quote, a call, or a straight answer if the timing is not right yet.",
  },
];
---

<section
  class="k-turn section"
  id="turning-point"
  aria-label="A calm invitation to ask Kersivo for a quote"
  data-light-zone
  data-light-x="58"
  data-light-y="56"
  data-light-size="1.02"
  data-light-strength="0.7"
  data-light-focus="0.38"
>
  <div class="container k-turn__wrap">
    <header class="k-turn__intro" data-turn-reveal style="--turn-delay:0ms;">
      <p class="k-turn__eyebrow">Ready to move forward?</p>

      <h2 class="k-turn__title">
        If the fit feels right, this is where the conversation becomes real.
      </h2>

      <p class="k-turn__lead">
        By now the value should already feel clear. This section is simply the calmer next
        step: a place to pause, picture the stronger version of the business online, and
        reach out when you are ready for a quote or a clearer direction.
      </p>
    </header>

    <div class="k-turn__panel" data-turn-reveal style="--turn-delay:120ms;">
      <div class="k-turn__panelTop">
        <div class="k-turn__panelCopy">
          <p class="k-turn__panelEyebrow">Quote enquiry</p>
          <h3 class="k-turn__panelTitle">
            Tell us what needs to change. We will come back with a clear view on fit,
            scope, and next steps.
          </h3>
          <p class="k-turn__panelText">
            No drawn-out sales theatre. Just a straightforward first conversation about
            the business, the gap the website needs to close, and what a proper solution
            is likely to involve.
          </p>
        </div>

        <div class="k-turn__panelAside">
          <p class="k-turn__asideLabel">What the first enquiry gives you</p>

          <ul class="k-turn__assurances" aria-label="What the first enquiry gives you">
            {enquiryOutcomes.map((item) => (
              <li class="k-turn__assurance">
                <p class="k-turn__assuranceLabel">{item.label}</p>
                <p class="k-turn__assuranceText">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="k-turn__foot">
        <p class="k-turn__footNote">
          A short email with your current site, goals, and rough timing is usually enough
          to begin.
        </p>

        <div class="k-turn__actions">
          <CtaButton href="/contact/#contact" label="Ask for a quote" variant="primary" />

          <a class="k-turn__email" href={`mailto:${contactEmail}`}>
            <span>Prefer to write directly?</span>
            <span>{contactEmail}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("#turning-point");
      if (!root) return;

      const revealItems = Array.from(root.querySelectorAll("[data-turn-reveal]"));
      if (!revealItems.length) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      revealItems.forEach((item, index) => {
        if (!item.style.getPropertyValue("--turn-delay")) {
          item.style.setProperty("--turn-delay", `${index * 120}ms`);
        }
      });

      if (reduced || !("IntersectionObserver" in window)) {
        root.classList.add("is-revealed");
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            root.classList.add("is-revealed");
            observer.disconnect();
          });
        },
        { threshold: 0.22 }
      );

      observer.observe(root);
    })();
  </script>
</section>
