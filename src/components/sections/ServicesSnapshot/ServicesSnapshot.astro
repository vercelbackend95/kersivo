---
import "./services-snapshot.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import { CTA_PRIMARY_CONTACT } from "../../../site/cta";

const services = [
  {
    num: "01",
    title: "Website redesign",
    text: "For established businesses that have outgrown their current site and need it to match the quality of their work.",
    includes: [
      "Offer clarity and messaging audit",
      "Premium design, mobile-first",
      "Astro-first performance build",
      "SEO foundations included",
    ],
    icon: `<path d="M4 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5Z" stroke="currentColor" stroke-width="1.6"/><path d="M4 12a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6Z" stroke="currentColor" stroke-width="1.6"/><path d="M16 12a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-6Z" stroke="currentColor" stroke-width="1.6"/>`,
  },
  {
    num: "02",
    title: "New website build",
    text: "From strategy and information architecture through premium design to a production-ready, fast, maintainable build.",
    includes: [
      "Strategy, structure and IA",
      "Brand-aligned UI system",
      "Development and QA",
      "Handover-ready documentation",
    ],
    icon: `<path d="M12 3 3 8.5v7L12 21l9-5.5v-7L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m3 8.5 9 5 9-5" stroke="currentColor" stroke-width="1.6"/><path d="M12 13.5V21" stroke="currentColor" stroke-width="1.6"/>`,
  },
  {
    num: "03",
    title: "Performance & conversion",
    text: "Improve speed, clarity, and enquiry flow on an existing site — without a full rebuild.",
    includes: [
      "Conversion and UX audit",
      "Page speed improvements",
      "Mobile experience polish",
      "Copy and messaging tightening",
    ],
    icon: `<path d="M3 12h4l3-7 4 14 3-7h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
] as const;
---

<section
  class="ks-services section"
  id="services"
  aria-labelledby="ks-services-heading"
  data-light-zone
  data-light-x="52"
  data-light-y="44"
  data-light-size="1"
  data-light-strength="0.58"
  data-light-focus="0.38"
>
  <div class="container ks-services__container">

    <header class="ks-services__head">
      <p class="k-kicker">What we build</p>
      <h2 class="ks-services__h2" id="ks-services-heading">
        Service formats matched to your growth stage.
      </h2>
      <p class="ks-services__lead">
        Clear scope, senior execution, and a defined outcome — for each type of project.
      </p>
    </header>

    <div class="ks-services__grid" role="list" aria-label="Our services">
      {services.map((svc) => (
        <article class="ks-services__card" role="listitem">
          <p class="ks-services__cardNum" aria-hidden="true">{svc.num}</p>
          <span class="ks-services__cardIcon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" set:html={svc.icon} />
          </span>
          <div class="ks-services__cardBody">
            <h3 class="ks-services__cardTitle">{svc.title}</h3>
            <p class="ks-services__cardText">{svc.text}</p>
            <ul class="ks-services__cardIncludes" aria-label={`${svc.title} includes`}>
              {svc.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="ks-services__foot">
      <div class="ks-services__ctas" role="group" aria-label="Next steps">
        <CtaButton
          href="/#contact"
          label={CTA_PRIMARY_CONTACT}
          variant="primary"
          arrow={true}
          magnetic={false}
        />
        <CtaButton
          href="/packages/"
          label="Compare packages"
          variant="secondary"
          arrow={true}
          magnetic={false}
        />
      </div>
      <p class="ks-services__footNote">Or ask directly — we will advise on the right fit.</p>
    </div>

  </div>
</section>
