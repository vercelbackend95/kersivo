---
import "./footer.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const year = new Date().getFullYear();

interface Props {
  showTopCta?: boolean;
}

const { showTopCta = true } = Astro.props as Props;
const footCardClasses = `k-footcard${showTopCta ? "" : " k-footcard--flush"}`;

/** Pages that render InlineContactLead with `id="contact"` (same-origin anchor). */
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const contactHref = path === "/packages" ? "/packages/#contact" : "/#contact";

const nav = [
  {
    title: "Selected work",
    links: [
      { label: "Overview", href: "/work/" },
      { label: "What we build", href: "/#services" },
      { label: "Packages & pricing", href: "/packages/" },
    ],
  },
  {
    title: "Studio",
    links: [
      { label: "Meet the founder", href: "/studio/" },
      { label: "How we work", href: "/#process-overview" },
      { label: "FAQ", href: "/#faq" },
      { label: "Contact", href: contactHref },
    ],
  },
];

const legal = [
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms of Service", href: "/terms/" },
  { label: "Cookies Settings", href: "/cookies/" },
];
---

<section
  class="k-footer2"
  aria-label="Footer"
  data-light-zone
  data-light-x="50"
  data-light-y="26"
  data-light-size="0.92"
  data-light-strength="0.58"
  data-light-focus="0.28"
>
  <div class="k-footer2__wrap container">
    {showTopCta && (
    <div class="k-footcta" role="region" aria-label="Call to action">
      <div class="k-footcta__inner">
        <h2 class="k-footcta__title">Ready to upgrade your website?</h2>
        <p class="k-footcta__sub">
          Premium design, ruthless performance, and a conversion-led structure — built for UK small businesses.
        </p>

        <div class="k-footcta__actions">
          <CtaButton href="/#contact" label="Get a quote" variant="primary" />
        </div>
      </div>
    </div>
    )}

    <footer class={footCardClasses} role="contentinfo">
      <div class="k-footcard__top">
        <div class="k-footcard__brand">
          <a class="k-footcard__logo" href="/" aria-label="Kersivo home">
            <span class="k-footcard__mark" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 2l1.2 5.1L18 8.3l-4.4 2.4L12 16l-1.6-5.3L6 8.3l4.8-1.2L12 2Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path
                  d="M19.5 13l.6 2.3 2.4.6-2.4.6-.6 2.3-.6-2.3-2.4-.6 2.4-.6.6-2.3Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <span class="k-footcard__name">Kersivo</span>
          </a>

          <p class="k-footcard__blurb">
            Premium, performance-first websites for UK small businesses that need to look as strong as they are.
          </p>

          <div class="k-footcard__truststrip" aria-label="Contact details">
            <span class="k-footcard__trustitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Z" stroke="currentColor" stroke-width="1.7"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.7"/>
              </svg>
              UK-based studio
            </span>
            <span class="k-footcard__trustitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                <path d="M12 7v5.25l3 1.75" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              Replies within 12 hours
            </span>
            <a class="k-footcard__trustitem k-footcard__trustitem--link" href="mailto:hello@kersivo.co.uk">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/>
                <path d="M3 7l9 7 9-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
              hello@kersivo.co.uk
            </a>
          </div>
        </div>

        <nav class="k-footcard__nav" aria-label="Footer navigation">
          {nav.map((col) => (
            <div class="k-footcard__col">
              <h3 class="k-footcard__title">{col.title}</h3>
              <ul class="k-footcard__list">
                {col.links.map((l) => (
                  <li><a class="k-footcard__link" href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>

      <div class="k-footcard__divider" aria-hidden="true"></div>

      <div class="k-footcard__bottom">
        <div class="k-footcard__copy">© {year} Kersivo. All rights reserved.</div>

        <div class="k-footcard__legal" aria-label="Legal links">
          {legal.map((l, i) => (
            <>
              <a class="k-footcard__legalLink" href={l.href}>{l.label}</a>
              {i < legal.length - 1 ? <span class="k-footcard__dot" aria-hidden="true">·</span> : null}
            </>
          ))}
        </div>
      </div>
    </footer>

    <!-- GIANT GHOST WORD (coming out from under) -->
    <div class="k-footer2__ghost" aria-hidden="true">Kersivo</div>
  </div>
</section>
