---
import "./about.css";

const differentiators = [
  {
    label: "Positioning quality",
    title: "Messaging built for buying decisions",
    text: "Service pages are structured around objections, trust signals, and clear next steps, not generic portfolio language.",
  },
  {
    label: "Execution discipline",
    title: "Premium output without production bloat",
    text: "The process stays lean and practical, so quality is high, delivery is controlled, and teams are not buried in unnecessary complexity.",
  },
  {
    label: "Commercial focus",
    title: "Designed to move visitors to contact",
    text: "Every major section has a clear role in the journey from first impression to enquiry intent, especially on mobile.",
  },

];
const proofSignals = [
  {
    metric: "Decision path",
    value: "Hero → trust → proof → contact",
  },
  {
    metric: "Primary KPI",
    value: "Qualified service enquiries",
  },
  {
    metric: "Build standard",
    value: "Fast, maintainable, mobile-first",
  },
];

---

<section class="k-about section" id="about" aria-label="Why clients choose Kersivo">
  <div class="container">
    <div class="k-about__grid">
 
      <div class="k-about__left">
        <p class="k-about__eyebrow">Why clients choose Kersivo</p>
        <h2 class="k-about__title">
          Strategic web delivery for small businesses that need more than a <span class="k-about__muted">good-looking site.</span>
        </h2>
        <p class="k-about__intro">
          After process clarity comes the real decision: who can turn that process into a credible, conversion-aware website that actually supports sales.
        </p>

      </div>
      <div class="k-about__right" role="list" aria-label="Key reasons clients choose Kersivo">
        {differentiators.map((item) => (
          <article class="k-about__card" role="listitem">
            <p class="k-about__card-label">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}


      </div>
    </div>
        <div class="k-about__proofBand" aria-label="Proof signals">
      {proofSignals.map((item) => (
        <div class="k-about__proofItem">
          <small>{item.metric}</small>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>
  </div>

</section>
