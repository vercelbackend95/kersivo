---
import "./about.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
const differentiators = [
  {
    label: "Positioning quality",
    title: "Messaging built for buying decisions",
    text: "Each key page is structured around what prospects need to see before they enquire: offer clarity, proof, and next step.",
  },
  {
    label: "Execution discipline",
    title: "Premium output without production bloat",
    text: "Design and development stay lean, documented, and accountable, so quality stays high without dragging your team into noise.",
  },
  {
    label: "Commercial focus",
    title: "Designed to move visitors to contact",
    text: "Sections are built with a clear conversion role, especially on mobile where most first visits and contact decisions happen.",
  },

];
const proofSignals = [
  {
    metric: "Live client site",
    value: "sewingataga.co.uk",

  },
  {
    metric: "Build approach",
    value: "Astro-first, performance-led",


  },
  {
    metric: "Best-fit clients",
    value: "UK service-led small businesses",


  },
];

---

<section class="k-about section" id="about" aria-label="Why clients choose Kersivo">
  <div class="container">
    <div class="k-about__grid">
 
      <div class="k-about__left">
        <p class="k-about__eyebrow">Why clients choose Kersivo</p>
        <h2 class="k-about__title">
                  Strategic websites for teams that need <span class="k-about__muted">better enquiries, not just better visuals.</span>
        </h2>
        <p class="k-about__intro">
          Once process is clear, the real decision is execution quality. Kersivo combines premium presentation with practical conversion logic so your website helps sales, not only brand perception.
        </p>
        <div class="k-about__ctaRow">
          <CtaButton href="/contact/#contact" label="Start your project" variant="primary" />
          <CtaButton href="/packages" label="View packages" variant="ghost" />
        </div>


      </div>
      <div class="k-about__right" role="list" aria-label="Key reasons clients choose Kersivo">
        {differentiators.map((item) => (
          <article class="k-about__card" role="listitem">
            <p class="k-about__card-label">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}


      </div>
    </div>
        <div class="k-about__proofBand" aria-label="Proof signals">
      {proofSignals.map((item) => (
        <div class="k-about__proofItem">
          <small>{item.metric}</small>
          <strong>{item.value}</strong>
        </div>
      ))}
    </div>
  </div>

</section>
