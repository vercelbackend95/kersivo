---
import "./about.css";

const points = [
  "Defined scope and timeline before production starts",
  "Conversion-led page structure built around enquiry intent",
  "Mobile-first delivery with clean handover documentation",
];

---

<section class="k-about section" id="about" aria-label="Proof and delivery snapshot">
  <div class="container">
    <div class="k-about__grid">
 
      <div class="k-about__left">
                <p class="k-about__eyebrow">Why clients choose Kersivo</p>
        <h2 class="k-about__title">
          Proof-led delivery for UK small businesses that need a site that <span class="k-about__muted">earns trust and drives enquiries.</span>
        </h2>

        <div class="k-about__tabs" role="tablist" aria-label="Proof tabs">
          <button
            class="k-about__tab is-active"
            type="button"
            role="tab"
                        id="about-tab-outcomes"
            aria-selected="true"
            aria-controls="about-panel"
            data-about-tab="outcomes"

          >
            Outcomes
          </button>

          <button
            class="k-about__tab"
            type="button"
            role="tab"
                        id="about-tab-delivery"
            aria-selected="false"
            aria-controls="about-panel"
            data-about-tab="delivery"

          >
            Delivery model
          </button>

          <button
            class="k-about__tab"
            type="button"
            role="tab"
                        id="about-tab-handover"
            aria-selected="false"
            aria-controls="about-panel"
            data-about-tab="handover"

          >
            Handover
          </button>
        </div>

        <div class="k-about__copy" aria-live="polite" role="tabpanel" id="about-panel" aria-labelledby="about-tab-outcomes">
          <p data-about-copy>
            Every build is shaped around one goal: convert serious interest into qualified enquiries without sacrificing premium presentation.
          </p>
                    <ul class="k-about__list" data-about-list>
            {points.map((point) => <li>{point}</li>)}
          </ul>

        </div>
      </div>
      <div class="k-about__right" aria-label="Proof snapshot">
        <article class="k-about__proof" data-about-proof>
          <p class="k-about__proof-kicker" data-about-proof-kicker>Default project structure</p>
          <h3 data-about-proof-title>4-stage process with checkpoints</h3>
          <p data-about-proof-copy>
            Discovery, scope, build, and launch are documented up front so clients always know what is happening, what is included, and what comes next.
          </p>

          <div class="k-about__proof-metrics">
            <div>
              <small>Timeline clarity</small>
              <strong data-about-metric="a">Defined before build</strong>
            </div>
            <div>
              <small>Primary KPI focus</small>
              <strong data-about-metric="b">Qualified enquiries</strong>
            </div>
          </div>
        </article>

      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("#about");
      if (!root) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const btns = Array.from(root.querySelectorAll("[data-about-tab]"));
      const copy = root.querySelector("[data-about-copy]");
      const list = root.querySelector("[data-about-list]");
      const panel = root.querySelector("#about-panel");
      const proofKicker = root.querySelector("[data-about-proof-kicker]");
      const proofTitle = root.querySelector("[data-about-proof-title]");
      const proofCopy = root.querySelector("[data-about-proof-copy]");
      const metricA = root.querySelector('[data-about-metric="a"]');
      const metricB = root.querySelector('[data-about-metric="b"]');

      if (!btns.length || !copy || !list || !panel || !proofKicker || !proofTitle || !proofCopy || !metricA || !metricB) return;

      const CONTENT = {
        outcomes: {
          copy:
            "Every build is shaped around one goal: convert serious interest into qualified enquiries without sacrificing premium presentation.",
          points: [
            "Messaging hierarchy designed for service-based buying decisions",
            "Strategic CTA placement across the page, not just in the hero",
            "Structure optimised for trust, clarity, and action on mobile",
          ],
          kicker: "Commercial focus",
          title: "Built around enquiry intent, not decoration",
          proof:
            "Page sections are planned to reduce friction: clear offer framing, trust signals near decision points, and short paths to contact.",
          a: "Buyer-focused page flow",
          b: "Conversion-led UX",
        },
        delivery: {
          copy:
            "Delivery follows a documented production model, so clients get consistent quality without confusion, missed scope, or endless revisions.",
          points: [
            "Scope and timeline agreed before the design phase starts",
            "Structured checkpoints for feedback and approvals",
            "Lean tooling and clean code foundations for long-term maintainability",
          ],
          kicker: "Operational reliability",
          title: "A clear process from discovery to launch",
          proof:
            "Each project runs through defined phases with ownership and outputs made explicit from day one. That keeps delivery calm, fast, and predictable.",
          a: "4 defined project stages",
          b: "Checkpoint-led delivery",
        },
        handover: {
          copy:
            "Launch is not the finish line. Handover is structured so teams can manage content confidently and continue growth without technical dependency.",
          points: [
            "Performance and QA checks completed before go-live",
            "Practical handover notes for updates and day-to-day edits",
            "Site architecture designed for future service expansion",
          ],
          kicker: "Post-launch confidence",
          title: "A handover clients can actually use",
          proof:
            "The final delivery includes practical guidance, clean architecture, and a stable baseline so the website stays useful long after launch.",
          a: "Launch QA completed",
          b: "Maintainable architecture",
        },
      };

      const animateSwap = (el) => {
        if (!el || reduced) return;
        el.classList.remove("is-swap");
        void el.offsetWidth;
        el.classList.add("is-swap");
        setTimeout(() => el.classList.remove("is-swap"), 320);

      };

      const setActive = (key) => {
        const next = CONTENT[key] || CONTENT.outcomes;
        btns.forEach((b) => {
          const active = b.getAttribute("data-about-tab") === key;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
          if (active) {
            panel.setAttribute("aria-labelledby", b.id);
          }

        });

        if (!reduced) {
          animateSwap(root.querySelector(".k-about__copy"));
          animateSwap(root.querySelector(".k-about__proof"));
        }

        copy.textContent = next.copy;
        list.innerHTML = next.points.map((point) => `<li>${point}</li>`).join("");
        proofKicker.textContent = next.kicker;
        proofTitle.textContent = next.title;
        proofCopy.textContent = next.proof;
        metricA.textContent = next.a;
        metricB.textContent = next.b;

      };

      btns.forEach((b) => {
        b.addEventListener("click", () => {
          const key = b.getAttribute("data-about-tab");
          if (!key) return;
          setActive(key);
        });
      });
    })();
  </script>
</section>
