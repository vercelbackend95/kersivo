---
import "./presence-intro.css";

const outcomes = [
  {
    index: "01",
    label: "Trust",
    title: "Looks established earlier.",
    text: "The business reads as credible before visitors start testing the details.",
  },
  {
    index: "02",
    label: "Value",
    title: "Value feels easier to justify.",
    text: "Price, quality, and fit land with less resistance because the presentation matches the level.",
  },
  {
    index: "03",
    label: "Enquiries",
    title: "Enquiries arrive warmer and clearer.",
    text: "The next step feels safer, so the right people reach out with stronger intent.",
  },
];
---

<section
  class="k-arrival section"
  id="next-stage"
  aria-label="How the website starts earning trust at the right level sooner"
  data-light-zone
  data-light-x="58"
  data-light-y="24"
  data-light-size="1.04"
  data-light-strength="0.8"
  data-light-focus="0.34"
  data-light-spread="0.78"
>
  <div class="container k-arrival__container">
    <article class="k-arrival__card">
      <div class="k-arrival__body">
        <header class="k-arrival__intro">
          <p class="k-arrival__eyebrow">Where the first impression starts earning trust</p>

          <h2 class="k-arrival__title">
            <span class="k-arrival__titleLine">Trusted at the</span>
            <span class="k-arrival__titleLine">right level,</span>
            <span class="k-arrival__titleLine k-arrival__titleLine--soft">sooner.</span>
          </h2>

          <p class="k-arrival__lead">
            When the site finally matches the standard of the work, price, quality, and
            intent all land with less resistance.
          </p>

          <p class="k-arrival__support">
            The opening seconds stop underselling the business and start doing commercial
            work before the first call.
          </p>
        </header>

        <aside class="k-arrival__ledger" aria-labelledby="arrival-ledger-heading">
          <div class="k-arrival__ledgerHead">
            <p class="k-arrival__ledgerKicker" id="arrival-ledger-heading">What shifts first</p>
            <p class="k-arrival__ledgerIntro">
              Three signals people read before they read the details.
            </p>
          </div>

          <div class="k-arrival__outcomes" role="list" aria-label="Commercial outcomes of a stronger website">
            {outcomes.map((item) => (
              <article class="k-arrival__outcome" role="listitem">
                <div class="k-arrival__outcomeIndex">{item.index}</div>

                <div class="k-arrival__outcomeBody">
                  <p class="k-arrival__outcomeLabel">{item.label}</p>
                  <p class="k-arrival__outcomeTitle">{item.title}</p>
                  <p class="k-arrival__outcomeText">{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </aside>
      </div>

      <footer class="k-arrival__proof" aria-label="Selected live proof">
        <div class="k-arrival__quoteBlock">
          <p class="k-arrival__proofLabel">Selected client note</p>

          <blockquote class="k-arrival__proofQuote">
            <p>"Feels premium while still being practical for day-to-day enquiries."</p>
          </blockquote>
        </div>

        <a
          class="k-arrival__seal"
          href="https://sewingataga.co.uk"
          target="_blank"
          rel="noreferrer"
          aria-label="Open the live Sewing Ataga client website"
        >
          <span class="k-arrival__sealLabel">Live reference</span>
          <span class="k-arrival__sealTitle">Sewing Ataga</span>
          <span class="k-arrival__sealMeta">Tailoring business, UK</span>
        </a>
      </footer>
    </article>
  </div>
</section>
