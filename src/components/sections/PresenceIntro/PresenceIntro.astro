---
import "./presence-intro.css";

import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const blocks = [
  {
    number: "01",
    label: "Who we help",
    title: "Established UK small businesses",
    text: "Service-led teams with a strong reputation whose website no longer reflects their quality.",
  },
  {
    number: "02",
    label: "What you get",
    title: "A site built to earn trust fast",
    text: "Premium design, disciplined development, and performance-first foundations shaped for better enquiries.",
  },
  {
    number: "03",
    label: "What happens next",
    title: "One clear next step",
    text: "Share your current site and goals; we reply within 12 hours with fit, scope, and a realistic route.",
  },
] as const;
---

<section
  class="k-bridge section"
  id="first-decision"
  aria-labelledby="k-bridge-heading"
  data-light-zone
  data-light-x="44"
  data-light-y="42"
  data-light-size="1"
  data-light-strength="0.52"
  data-light-focus="0.38"
>
  <div class="container k-bridge__container">
    <header class="k-bridge__head">
      <p class="k-bridge__kicker">Clarity at a glance</p>
    </header>

    <div class="k-bridge__panel" role="list" aria-labelledby="k-bridge-heading">
      <h2 class="k-bridge__srOnly" id="k-bridge-heading">Who we help, what you get, and what happens next</h2>
      {blocks.map((block) => (
        <article class="k-bridge__block" role="listitem">
          <p class="k-bridge__meta">
            <span class="k-bridge__number" aria-hidden="true">{block.number}</span>
            <span class="k-bridge__label">{block.label}</span>
          </p>
          <h3 class="k-bridge__title">{block.title}</h3>
          <p class="k-bridge__copy">{block.text}</p>
        </article>
      ))}
    </div>

    <footer class="k-bridge__ctaRow">
      <div class="k-bridge__actions">
          <CtaButton
            href="/#contact"
            label="Ask for a quote"
            variant="primary"
            class="k-bridge__ctaPrimary"
            magnetic={false}
            arrow={false}
          />
      </div>
      <p class="k-bridge__micro">No hard sell. Clear fit-first reply.</p>
    </footer>
  </div>
</section>
