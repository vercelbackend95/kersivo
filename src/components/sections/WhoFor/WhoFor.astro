---
import "./who-for.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const bestFor = [
  "UK service businesses upgrading from an outdated site",
  "Owner-led teams that need a premium first impression",
  "Teams that want clearer enquiries, not just more traffic",
];

const alsoWorksFor = [
  "First serious website after relying on social media only",
  "Site refresh after poor freelancer handover",
  "Businesses that need launch support without agency dependency",
];

const everyProjectIncludes = [
  "Clear scope and timeline before production",
  "Mobile-first build with performance checks",
  "Practical handover your team can actually use",
];

---

<section class="k-fit section" id="who-its-for" aria-label="Who we work best with">
  <div class="container k-fit__container">
    <header class="k-fit__head">
      <p class="k-fit__kicker">Who we work best with</p>
      <h2 class="k-fit__title">
        Built for small businesses that need a site to <span>look premium and win trust fast.</span>
      </h2>
      <p class="k-fit__lead">
        If you need more enquiries and a cleaner process, this is likely a good fit.

      </p>
    </header>

    <div class="k-fit__grid" role="list" aria-label="Client fit guidance">
      <article class="k-fit__card" role="listitem" aria-label="Best for">
        <h3>Best for</h3>
        <ul>
          {bestFor.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="k-fit__card" role="listitem" aria-label="Also works for">
        <h3>Also works for</h3>
        <ul>
          {alsoWorksFor.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>

    <div class="k-fit__includes" aria-label="What every project includes">
      <p class="k-fit__includesLabel">Every Kersivo project includes</p>
      <ul>
        {everyProjectIncludes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="k-fit__ctaRow">
      <CtaButton href="/contact/#contact" label="Book a discovery call" variant="primary" />
      <p class="k-fit__ctaNote">Not sure if it’s the right fit? We can still review your current site.</p>

    </div>
  </div>
</section>
