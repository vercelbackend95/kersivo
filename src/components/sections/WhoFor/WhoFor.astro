---
import "./who-for.css";

const fitPoints = [
  {
    title: "Clear growth intent",
    text: "You want the website to support better enquiries, not just look newer.",
  },
  {
    title: "Decision-ready team",
    text: "The key decision-maker can review direction promptly and keep momentum.",
  },
  {
    title: "Quality over shortcuts",
    text: "You care about a considered build, performance, and long-term maintainability.",
  },
  {
    title: "Practical collaboration",
    text: "You prefer focused feedback rounds and straightforward communication over noise.",
  },
];

const nonFitPoints = [
  "If lowest price is the only priority, we may not be the right partner.",
  "If you need a rushed launch without room for structure, quality will suffer.",
];
---

<section
  class="k-fit section"
  id="who-its-for"
  aria-label="Who we work best with"
  data-light-zone
  data-light-x="56"
  data-light-y="46"
  data-light-size="0.98"
  data-light-strength="0.6"
  data-light-focus="0.3"
>
  <div class="container">
    <div class="k-fit__grid">
      <header class="k-fit__intro">
        <p class="k-fit__eyebrow">Clarity and standards</p>
        <h2 class="k-fit__title">Who we work best with.</h2>
        <p class="k-fit__lead">
          We do our best work with service businesses that value clear positioning, calm delivery,
          and websites built to convert, not just impress.
        </p>
        <p class="k-fit__support">
          This helps keep projects focused and outcomes stronger for both sides.
        </p>
      </header>

      <div class="k-fit__content">
        <div class="k-fit__standards" role="list" aria-label="Who we work best with">
          {fitPoints.map((point, index) => (
            <article class="k-fit__standard" role="listitem">
              <p class="k-fit__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
              <div class="k-fit__body">
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </div>
            </article>
          ))}
        </div>

        <aside class="k-fit__note" aria-label="When we may not be the best fit">
          <p class="k-fit__noteTitle">We may not be the best fit if:</p>
          <ul>
            {nonFitPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </aside>

        <a class="k-fit__cta" href="/#contact">
          <span>See if we are a fit</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
