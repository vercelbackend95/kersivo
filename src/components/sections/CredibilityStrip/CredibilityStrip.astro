---
import "./credibility-strip.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
const trustSignals = [
  "Structured scope before production",
  "Mobile-first quality checks before launch",
  "Practical handover, not agency dependency",
];


const steps = [
  {
    title: "1. Scope around business goals",
    text: "We start with offer clarity, target audience, and enquiry goals, then lock scope, timeline, and owners.",


  },
  {
    title: "2. Build through decision checkpoints",
    text: "Design and development move in short approval rounds, so decisions stay focused and delivery stays predictable.",



  },
  {
    title: "3. Launch with clean handover",
    text: "You get a production-ready site, QA across core breakpoints, and handover notes your team can actually use.",


  },
];

---
<section class="k-credStrip section" aria-label="How projects are delivered">
  <div class="container">
    <div class="k-credStrip__shell" data-cred-shell>
      <header class="k-credStrip__head" data-cred-item>
        <p class="k-credStrip__eyebrow">Built for UK small businesses</p>
        <h2 class="k-credStrip__title">
          A delivery system built to <span>reduce risk</span> and keep momentum.
        </h2>
                <ul class="k-credStrip__signals" aria-label="Project reliability signals">
          {trustSignals.map((item) => <li>{item}</li>)}
        </ul>

      </header>

      <div class="k-credStrip__grid" role="list" aria-label="Delivery steps" data-cred-item>
        {steps.map((item) => (

          <article class="k-credStrip__card" role="listitem">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>

      <div class="k-credStrip__foot" data-cred-item>
        <p class="k-credStrip__meta">
          Every project follows one structure: clear scope, controlled production, then launch support with no ambiguity.
        </p>


        <div class="k-credStrip__cta">
          <CtaButton href="/contact/#contact" label="Book a discovery call" variant="primary" />
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("[data-cred-shell]");
      if (!root) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = root.querySelectorAll("[data-cred-item]");

      if (!items.length) return;
      if (reduced) {
        items.forEach((el) => el.classList.add("is-in"));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      items.forEach((el, i) => {
        el.style.setProperty("--d", `${i * 85}ms`);
        io.observe(el);
      });
    })();
  </script>
</section>
