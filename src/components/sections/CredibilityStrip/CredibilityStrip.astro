---
import "./credibility-strip.css";

const calibrationPoints = [
  {
    key: "trust",
    label: "First impression",
    statement: "Trust has to land fast.",
    lead: "Especially on mobile, where most first visits and contact decisions happen.",
    text: "Offer clarity, visual confidence, and proof are placed where hesitation usually starts.",
  },
  {
    key: "time",
    label: "Owner attention",
    statement: "Time is tight.",
    lead: "The process has to move cleanly, without dragging the owner into agency theatre.",
    text: "Short decision rounds, defined scope, and a handover your team can actually use.",
  },
  {
    key: "weight",
    label: "Commercial role",
    statement: "The site has to pull its weight.",
    lead: "It should sharpen perception, filter fit, and help better enquiries happen.",
    text: "Built around enquiry quality, not vanity traffic or decorative complexity.",
  },
];
---

<section class="k-credStrip section" id="built-for" aria-label="Built for UK small businesses">
  <div class="container k-credStrip__container">
    <header class="k-credStrip__intro" data-cred-reveal>
      <div class="k-credStrip__introMeta">
        <p class="k-credStrip__eyebrow">Built for UK small businesses</p>
        <p class="k-credStrip__micro">Premium work, shaped around real owner pressure.</p>
      </div>

      <div class="k-credStrip__introMain">
        <h2 class="k-credStrip__title">Built around how small businesses actually decide.</h2>
        <p class="k-credStrip__lead">
          Trust has to land quickly, the process has to stay clear, and the site has to
          help the right enquiries happen. That is what shapes the work.
        </p>
      </div>
    </header>

    <div
      class="k-credStrip__field"
      role="list"
      aria-label="What shapes the work for UK small businesses"
    >
      {calibrationPoints.map((item, index) => (
        <article
          class={`k-credStrip__line k-credStrip__line--${item.key}`}
          role="listitem"
          data-cred-line
          style={`--cred-delay:${index * 88}ms;`}
        >
          <div class="k-credStrip__lineMain">
            <p class="k-credStrip__lineLabel">{item.label}</p>
            <h3 class="k-credStrip__statement">{item.statement}</h3>
          </div>

          <div class="k-credStrip__lineNote">
            <p class="k-credStrip__noteLead">{item.lead}</p>
            <p class="k-credStrip__noteText">{item.text}</p>
          </div>
        </article>
      ))}
    </div>

    <footer class="k-credStrip__bridge" data-cred-reveal>
      <span class="k-credStrip__bridgeLine" aria-hidden="true"></span>
      <p class="k-credStrip__bridgeText">
        Then the decision becomes who can shape that with clarity, discipline, and
        commercial focus.
      </p>
    </footer>
  </div>

  <script>
    (() => {
      const root = document.querySelector("#built-for");
      if (!root) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = Array.from(
        root.querySelectorAll("[data-cred-reveal], [data-cred-line]")
      );

      if (!items.length) return;
      root.dataset.credEnhanced = "true";

      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((item) => item.classList.add("is-in"));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      items.forEach((item, index) => {
        if (!item.style.getPropertyValue("--cred-delay")) {
          item.style.setProperty("--cred-delay", `${index * 72}ms`);
        }
        io.observe(item);
      });
    })();
  </script>
</section>
