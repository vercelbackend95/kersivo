---
import "./credibility-strip.css";
---

<section
  class="k-proofScene section"
  id="built-for"
  aria-label="Designed proof scene"
  data-light-zone
  data-light-x="68"
  data-light-y="29"
  data-light-size="1.16"
  data-light-strength="0.92"
  data-light-focus="0.38"
  data-light-spread="0.84"
>
  <div class="container k-proofScene__container">
    <div class="k-proofScene__copy" data-proof-reveal style="--proof-delay:0ms;">
      <p class="k-proofScene__index" aria-hidden="true">02</p>
      <p class="k-proofScene__eyebrow">Designed proof</p>

      <h2 class="k-proofScene__title">
        <span class="k-proofScene__titleLine">Quality should feel</span>
        <span class="k-proofScene__titleLine k-proofScene__titleLine--accent">
          obvious on contact.
        </span>
      </h2>

      <p class="k-proofScene__lead">
        A few restrained fragments. Enough to show premium presentation, business clarity,
        and conversion-aware execution.
      </p>

      <div class="k-proofScene__footnote" aria-hidden="true">
        <span class="k-proofScene__footLine"></span>
        <p>Not a gallery. A confidence check.</p>
      </div>
    </div>

    <div class="k-proofScene__scene" role="list" aria-label="Curated proof fragments">
      <article
        class="k-proofScene__fragment k-proofScene__fragment--presentation"
        role="listitem"
        data-proof-reveal
        style="--proof-delay:100ms;"
      >
        <div class="k-proofScene__fragmentMeta">
          <span>Premium front-end</span>
          <span aria-hidden="true">/</span>
          <span>Presentation surface</span>
        </div>

        <div class="k-proofScene__presentationFrame">
          <div class="k-proofScene__presentationBar">
            <span class="k-proofScene__brandMark" aria-hidden="true"></span>
            <span>Northline Studio</span>
            <span class="k-proofScene__presentationStatus">Launch surface</span>
          </div>

          <div class="k-proofScene__presentationHero">
            <div class="k-proofScene__presentationCopy">
              <p class="k-proofScene__presentationEyebrow">Specialist positioning</p>
              <h3 class="k-proofScene__presentationTitle">
                Look established before the first call.
              </h3>
              <p class="k-proofScene__presentationText">
                Structured hierarchy, disciplined spacing, and enough polish to make the
                business feel further along.
              </p>
            </div>

            <div class="k-proofScene__presentationCrop" aria-hidden="true">
              <span class="k-proofScene__cropLine k-proofScene__cropLine--strong"></span>
              <span class="k-proofScene__cropLine"></span>
              <span class="k-proofScene__cropLine"></span>
              <span class="k-proofScene__cropLine k-proofScene__cropLine--short"></span>
            </div>
          </div>

          <div class="k-proofScene__presentationRail" aria-hidden="true">
            <div class="k-proofScene__presentationMetric">
              <small>Signal</small>
              <strong>Premium presence</strong>
            </div>
            <div class="k-proofScene__presentationMetric">
              <small>Structure</small>
              <strong>Calm hierarchy</strong>
            </div>
            <div class="k-proofScene__presentationMetric">
              <small>Outcome</small>
              <strong>Trust lands faster</strong>
            </div>
          </div>
        </div>
      </article>

      <article
        class="k-proofScene__fragment k-proofScene__fragment--system"
        role="listitem"
        data-proof-reveal
        style="--proof-delay:190ms;"
      >
        <div class="k-proofScene__fragmentMeta">
          <span>Recent build</span>
          <span aria-hidden="true">/</span>
          <span>Service system</span>
        </div>

        <div class="k-proofScene__stackTitle">
          <p class="k-proofScene__fragmentTitle">Shop + admin</p>
          <p class="k-proofScene__fragmentSub">Booking flow</p>
        </div>

        <p class="k-proofScene__fragmentText">
          A recent barber concept showing how presentation, booking and operations can work
          as one system.
        </p>

        <div class="k-proofScene__systemFlow" aria-hidden="true">
          <span>Service</span>
          <span>Slot</span>
          <span>Confirm</span>
        </div>

        <div class="k-proofScene__systemColumns" aria-hidden="true">
          <div class="k-proofScene__systemPanel">
            <small>Shop</small>
            <strong>Clean service choice</strong>
            <span>Fast, clear booking start</span>
          </div>

          <div class="k-proofScene__systemPanel">
            <small>Admin</small>
            <strong>Openings stay visible</strong>
            <span>Availability and queue in one view</span>
          </div>
        </div>

        <div class="k-proofScene__systemAvailability" aria-hidden="true">
          <span>Tue 11:30</span>
          <span>Wed 14:00</span>
          <span>Fri 09:15</span>
        </div>
      </article>

      <article
        class="k-proofScene__fragment k-proofScene__fragment--mobile"
        role="listitem"
        data-proof-reveal
        style="--proof-delay:260ms;"
      >
        <div class="k-proofScene__fragmentMeta">
          <span>Mobile clarity</span>
          <span aria-hidden="true">/</span>
          <span>Conversion path</span>
        </div>

        <div class="k-proofScene__phone" aria-hidden="true">
          <div class="k-proofScene__phoneTop">
            <span class="k-proofScene__phoneNotch"></span>
          </div>

          <div class="k-proofScene__phoneBody">
            <p class="k-proofScene__phoneLabel">Mobile</p>
            <p class="k-proofScene__phoneTitle">Cleaner paths to contact.</p>

            <div class="k-proofScene__phoneLines">
              <span class="k-proofScene__phoneLine k-proofScene__phoneLine--wide"></span>
              <span class="k-proofScene__phoneLine"></span>
              <span class="k-proofScene__phoneLine k-proofScene__phoneLine--short"></span>
            </div>

            <div class="k-proofScene__phoneAction">
              <span>Book consultation</span>
              <span aria-hidden="true">&rarr;</span>
            </div>

            <div class="k-proofScene__phoneMeta">
              <span>2 steps</span>
              <span>Clear next action</span>
            </div>
          </div>
        </div>

        <p class="k-proofScene__mobileNote">
          Built to stay clean, fast and usable where first-contact decisions usually happen.
        </p>
      </article>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("#built-for");
      if (!root) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = Array.from(root.querySelectorAll("[data-proof-reveal]"));

      if (!items.length) return;
      root.dataset.proofEnhanced = "true";

      if (reduced || !("IntersectionObserver" in window)) {
        items.forEach((item) => item.classList.add("is-in"));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.2 }
      );

      items.forEach((item, index) => {
        if (!item.style.getPropertyValue("--proof-delay")) {
          item.style.setProperty("--proof-delay", `${index * 90}ms`);
        }

        io.observe(item);
      });
    })();
  </script>
</section>
