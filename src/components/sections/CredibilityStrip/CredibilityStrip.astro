---
import "./credibility-strip.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";

const steps = [
  {
    title: "1. Discovery and scope",
    text: "We align on offer, audience, and priorities first, then lock deliverables, timeline, and responsibilities.",

  },
  {
    title: "2. Build with checkpoints",
    text: "Design and development run through defined review points, so decisions stay focused and delivery stays predictable.",


  },
  {
    title: "3. Launch and handover",
    text: "You get a production-ready, mobile-first site with practical handover notes your team can actually use.",

  },
];

---
<section class="k-credStrip section" aria-label="How projects are delivered">
  <div class="container">
    <div class="k-credStrip__shell" data-cred-shell>
      <header class="k-credStrip__head" data-cred-item>
        <p class="k-credStrip__eyebrow">Built for UK small businesses</p>
        <h2 class="k-credStrip__title">
          A clear process that <span>removes delivery guesswork</span> from day one.
        </h2>
      </header>

      <div class="k-credStrip__grid" role="list" aria-label="Delivery steps" data-cred-item>
        {steps.map((item) => (

          <article class="k-credStrip__card" role="listitem">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>

      <div class="k-credStrip__foot" data-cred-item>
        <p class="k-credStrip__meta">
          Every project follows the same structure: clarity first, controlled production, then a clean launch and handover.
        </p>


        <div class="k-credStrip__cta">
          <CtaButton href="/contact/#contact" label="Book a discovery call" variant="primary" />
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const root = document.querySelector("[data-cred-shell]");
      if (!root) return;

      const reduced =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = root.querySelectorAll("[data-cred-item]");

      if (!items.length) return;
      if (reduced) {
        items.forEach((el) => el.classList.add("is-in"));
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.18 }
      );

      items.forEach((el, i) => {
        el.style.setProperty("--d", `${i * 85}ms`);
        io.observe(el);
      });
    })();
  </script>
</section>
