---
import "./studio-page.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import { CTA_PRIMARY_CONTACT, CTA_SECONDARY_WORK } from "../../../site/cta";
import { homeContactHrefFromPagePath } from "../../../lib/leadSource";
import { studioAvailability } from "../../../site/studio";

const pagePath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const homeContactHref = homeContactHrefFromPagePath(pagePath);
---

<!-- ============================================================
     SECTION 1 — Opening Statement
     ============================================================ -->
<section
  class="ks-intro"
  aria-label="Studio introduction"
  data-light-zone
  data-light-x="46"
  data-light-y="12"
  data-light-size="1.2"
  data-light-strength="0.78"
  data-light-focus="0.18"
>
  <div class="container ks-intro__contain">
    <p class="ks-eyebrow">Kersivo Studio</p>

    <h1 class="ks-intro__headline">
      <span class="ks-line">Good design is</span>
      <span class="ks-line">a business decision,</span>
      <span class="ks-line"><em class="ks-em">not an aesthetic one.</em></span>
    </h1>

    <p class="ks-intro__sub">
      A founder-led web studio built on strategy, precision, and a stubborn
      commitment to quality — for established UK small businesses.
    </p>
  </div>
</section>

<!-- ============================================================
     SECTION 2 — Founder
     ============================================================ -->
<section
  class="ks-founder"
  aria-labelledby="founder-heading"
  data-light-zone
  data-light-x="74"
  data-light-y="52"
  data-light-size="0.88"
  data-light-strength="0.62"
  data-light-focus="0.24"
>
  <div class="container ks-founder__contain">

    <!-- Portrait — sticky on desktop, static on tablet/mobile -->
    <div class="ks-portrait-wrap">
      <!-- Replace /studio/founder.jpg with your actual portrait (3:4 recommended) -->
      <div class="ks-portrait">
        <span class="ks-portrait__fallback" aria-hidden="true">B</span>
        <img
          class="ks-portrait__img"
          src="/studio/founder.jpg"
          alt="Bartosz — Founder, Kersivo"
          width="480"
          height="640"
          loading="eager"
          decoding="async"
          onerror="this.style.visibility='hidden'"
        />
      </div>
    </div>

    <!-- Bio -->
    <div class="ks-founder__bio">
      <header class="ks-founder__header">
        <p class="ks-eyebrow">The engineering lead</p>

        <h2 id="founder-heading" class="ks-founder__name">Bartosz</h2>
        <p class="ks-founder__role">Founder · Designer · Developer</p>
      </header>

      <div class="ks-founder__prose">
        <p>
          Kersivo was founded on the principle that small UK businesses deserve the same technical rigour as
          enterprise-level platforms. The studio focuses on replacing generic templates with high-performance,
          purpose-built digital products.
        </p>
        <p>
          With a background spanning front-end engineering, conversion strategy, and bespoke logic, every project
          is handled directly at the founder level. This ensures zero dilution of quality and a single point of
          accountability from brief to deployment.
        </p>
        <p>
          The studio operates with a lean, focused approach — prioritizing technical stability and commercial
          outcomes over agency noise.
        </p>
      </div>
    </div>

  </div>
</section>

<!-- ============================================================
     SECTION 3 — How This Studio Works (4 Principles)
     ============================================================ -->
<section
  class="ks-principles"
  aria-labelledby="principles-heading"
  data-light-zone
  data-light-x="28"
  data-light-y="50"
  data-light-size="1.0"
  data-light-strength="0.52"
  data-light-focus="0.26"
>
  <div class="container">
    <header class="ks-principles__head">
      <p class="ks-eyebrow">How this studio works</p>
      <h2 id="principles-heading" class="ks-principles__title">
        Four things that don't change.
      </h2>
    </header>

    <ol class="ks-principles__list" role="list">
      <li class="ks-principle">
        <span class="ks-principle__num" aria-hidden="true">01</span>
        <div class="ks-principle__body">
          <h3 class="ks-principle__title">Single point of accountability</h3>
          <p class="ks-principle__desc">
            Direct senior-level execution. Every project is handled by the lead engineer from brief to deployment.
            This eliminates junior hand-offs and ensures the strategic thinking you pay for is exactly what is
            delivered.
          </p>
        </div>
      </li>

      <li class="ks-principle">
        <span class="ks-principle__num" aria-hidden="true">02</span>
        <div class="ks-principle__body">
          <h3 class="ks-principle__title">Strategy before aesthetics</h3>
          <p class="ks-principle__desc">
            Commercial logic precedes every design decision. A website must convert and build trust within seconds;
            looking good is a secondary requirement that follows clear communication and functional structure.
          </p>
        </div>
      </li>

      <li class="ks-principle">
        <span class="ks-principle__num" aria-hidden="true">03</span>
        <div class="ks-principle__body">
          <h3 class="ks-principle__title">Performance as a constraint</h3>
          <p class="ks-principle__desc">
            Speed and accessibility are treated with the same rigour as the visual layer. By utilizing frameworks like
            Astro, performance is engineered into the core of the build, not added as an afterthought.
          </p>
        </div>
      </li>

      <li class="ks-principle">
        <span class="ks-principle__num" aria-hidden="true">04</span>
        <div class="ks-principle__body">
          <h3 class="ks-principle__title">Focused output</h3>
          <p class="ks-principle__desc">
            Quality through deliberate volume control. Kersivo operates on a restricted project schedule to ensure each
            build receives the required technical depth and attention to detail.
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- ============================================================
     SECTION 4 — What You Actually Receive
     ============================================================ -->
<section
  class="ks-deliverables"
  aria-labelledby="deliverables-heading"
>
  <div class="container">
    <header class="ks-deliverables__head">
      <p class="ks-eyebrow">What you actually receive</p>
      <h2 id="deliverables-heading" class="ks-deliverables__title">
        A complete website,<br aria-hidden="true" /> built to last.
      </h2>
      <p class="ks-deliverables__lead">
        Every deployment is a high-performance asset, engineered for long-term stability and commercial growth.
      </p>
    </header>

    <ul class="ks-deliverables__list" role="list">
      <li class="ks-deliv">
        <svg class="ks-deliv__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/>
          <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <h3 class="ks-deliv__title">Bespoke engineering</h3>
        <p class="ks-deliv__desc">
          Engineered around brand objectives, audience behaviour, and commercial goals. A bespoke visual system with
          zero reliance on generic themes or restrictive templates.
        </p>
      </li>

      <li class="ks-deliv">
        <svg class="ks-deliv__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <h3 class="ks-deliv__title">Performance-first code</h3>
        <p class="ks-deliv__desc">
          Astro-built, edge-ready, and optimized for Core Web Vitals. Sub-second loading speeds that earn user trust
          before a single word is read — and keep search engines happy.
        </p>
      </li>

      <li class="ks-deliv">
        <svg class="ks-deliv__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 2l1.2 5.1L18 8.3l-4.4 2.4L12 16l-1.6-5.3L6 8.3l4.8-1.2L12 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <h3 class="ks-deliv__title">Conversion architecture</h3>
        <p class="ks-deliv__desc">
          Every page is structured to move visitors toward a specific decision. A clear visual hierarchy, intentional
          calls-to-action, and a journey designed to reduce friction.
        </p>
      </li>

      <li class="ks-deliv">
        <svg class="ks-deliv__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
          <path d="M20 20l-3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <h3 class="ks-deliv__title">Technical foundations</h3>
        <p class="ks-deliv__desc">
          Semantic markup, structured data, and technical SEO baked into the core. A solid, maintainable base that
          ensures visibility and performance from the moment of launch.
        </p>
      </li>
    </ul>
  </div>
</section>

<!-- ============================================================
     SECTION 5 — Credibility Strip
     ============================================================ -->
<section
  class="ks-credibility"
  aria-label="Studio at a glance"
>
  <div class="container">
    <ul class="ks-cred-list" role="list">
      <li class="ks-cred-item">
        <span class="ks-cred-label">Based in</span>
        <span class="ks-cred-value">United Kingdom</span>
      </li>
      <li class="ks-cred-item">
        <span class="ks-cred-label">{studioAvailability.credibilityLabel}</span>
        <span class="ks-cred-value">{studioAvailability.credibilityValue}</span>
      </li>
      <li class="ks-cred-item">
        <span class="ks-cred-label">Response time</span>
        <span class="ks-cred-value">Within 12 hours</span>
      </li>
      <li class="ks-cred-item">
        <span class="ks-cred-label">Project model</span>
        <span class="ks-cred-value">Bespoke. One client at a time.</span>
      </li>
    </ul>
  </div>
</section>

<!-- ============================================================
     SECTION 6 — Closing CTA
     ============================================================ -->
<section
  class="ks-studio-cta"
  aria-label="Start a project"
  data-light-zone
  data-light-x="50"
  data-light-y="50"
  data-light-size="1.1"
  data-light-strength="0.82"
  data-light-focus="0.2"
>
  <div class="container ks-studio-cta__contain">
    <p class="ks-eyebrow">Start the conversation</p>

    <h2 class="ks-studio-cta__title">
      Let's build something<br aria-hidden="true" />
      worth being proud of.
    </h2>

    <p class="ks-studio-cta__sub">
      Tell me about your project. I'll reply within 12 hours with honest
      thoughts on whether — and how — Kersivo can help.
    </p>

    <div class="ks-studio-cta__actions">
      <CtaButton href={homeContactHref} label={CTA_PRIMARY_CONTACT} variant="primary" />
      <CtaButton href="/work/" label={CTA_SECONDARY_WORK} variant="secondary" magnetic={false} />
    </div>

    <p class="ks-studio-cta__note">
      {studioAvailability.ctaNote}
    </p>
  </div>

  <div class="ks-studio-cta__ghost" aria-hidden="true">Studio</div>
</section>
