---
import "./fit-section.css";

const fitPoints = [
  {
    title: "Focus on outcomes",
    text: "The primary objective is to improve business perception and increase the quality of incoming enquiries. Performance is valued over purely aesthetic updates.",
  },
  {
    title: "Decisive momentum",
    text: "Decision-makers are available to review strategic direction and provide feedback at natural checkpoints, ensuring project momentum is maintained.",
  },
  {
    title: "Long-term value",
    text: "There is a preference for considered, high-quality builds — systems that perform well, age gracefully, and do not require constant technical patching.",
  },
  {
    title: "Focused collaboration",
    text: "Efficiency is prioritized over 'agency noise'. The process relies on structured feedback, clear technical communication, and the removal of unnecessary process theatre.",
  },
] as const;

const nonFitPoints = [
  "If the lowest possible price is the sole priority — Kersivo is unlikely to be the right technical partner.",
  "If a rushed launch leaves no room for structural integrity or quality review — the final outcome will suffer, and the project will be declined.",
] as const;
---

<section
  class="ks-fit section"
  id="who-its-for"
  aria-labelledby="ks-fit-heading"
  data-light-zone
  data-light-x="56"
  data-light-y="46"
  data-light-size="0.96"
  data-light-strength="0.58"
  data-light-focus="0.32"
>
  <div class="container ks-fit__container">

    <!-- Intro col (sticky on desktop) -->
    <header class="ks-fit__intro">
      <p class="k-kicker">Clarity and standards</p>
      <h2 class="ks-fit__h2" id="ks-fit-heading">
        Ideal partnership profile.
      </h2>
      <p class="ks-fit__lead">
        Kersivo standards are designed for service businesses that prioritize clear positioning, calm delivery, and digital products built to convert — not just impress.
      </p>
    </header>

    <!-- Content col -->
    <div class="ks-fit__content">
      <div class="ks-fit__list" role="list" aria-label="Who we work best with">
        {fitPoints.map((point, index) => (
          <article class="ks-fit__item" role="listitem">
            <p class="ks-fit__itemNum" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <div class="ks-fit__itemBody">
              <h3 class="ks-fit__itemTitle">{point.title}</h3>
              <p class="ks-fit__itemText">{point.text}</p>
            </div>
          </article>
        ))}
      </div>

      <aside class="ks-fit__note" aria-label="Compatibility check">
        <p class="ks-fit__noteTitle">Compatibility check:</p>
        <ul class="ks-fit__noteList">
          {nonFitPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    </div>

  </div>
</section>
