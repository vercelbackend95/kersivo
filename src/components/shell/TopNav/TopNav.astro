---
// src/components/shell/TopNav/TopNav.astro
import "./topnav.css";
import CtaButton from "../../ui/CtaButton/CtaButton.astro";
import MobileNav from "./MobileNav";
import { NAV_LINKS } from "./nav-links";

const rawPath = Astro.url.pathname || "/";
const pathname = rawPath.replace(/\/+$/, "") || "/";

function navPath(href: string) {
  return href.split("#")[0].replace(/\/+$/, "") || "/";
}

---

<header class="k-topnav" data-topnav>
  <a class="k-skip" href="#main">Skip to content</a>

  <div class="k-topnav__shell">
    <div class="k-topnav__surface">
      <div class="k-topnav__inner">
        <a class="k-topnav__brand" href="/" aria-label="Kersivo home">
          <span class="k-topnav__mark" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3.2 13.1 7.6 17.8 8.5 14.2 10.5 12 14.2 9.8 10.5 6.2 8.5 10.9 7.6 12 3.2Z"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="k-topnav__name">Kersivo</span>
        </a>

        <nav class="k-topnav__links" aria-label="Primary">
          {
            NAV_LINKS.map(({ href, label }) => {
              const hasHash = href.includes("#");
              const active = hasHash ? false : navPath(href) === pathname;
              return (
                <a
                  class:list={["k-topnav__link", { "is-active": active }]}
                  href={href}
                  data-nav-link={href}
                  aria-current={active ? "page" : undefined}
                >
                  {label}
                </a>
              );
            })
          }
        </nav>

        <div class="k-topnav__actions">
          <CtaButton
            href="/#contact"
            label="Get a quote"
            variant="primary"
            class="k-topnav__cta"
          />

          <button
            id="kNavToggle"
            class="k-topnav__burger"
            type="button"
            aria-controls="kMobileNavDialog"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <span class="k-topnav__burgerLines" aria-hidden="true">
              <span class="k-topnav__burgerLine" />
              <span class="k-topnav__burgerLine" />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <MobileNav client:load />

  <script>
    import { createActiveSectionScrollSpy } from "./active-section";

    (() => {
      const root = document.querySelector("[data-topnav]");
      if (!root) return;

      const onScroll = () => {
        const y = window.scrollY > 10;
        root.classList.toggle("is-scrolled", y);
      };

      const navLinks = Array.from(
        root.querySelectorAll('[data-nav-link^="/#"]')
      );

      const sections = navLinks
        .map((link) => {
          const href = link.getAttribute("data-nav-link") || "";
          const hash = href.split("#")[1];
          if (!hash) return null;
          const section = document.getElementById(hash);
          if (!section) return null;
          return { link, hash, section };
        })
        .filter(Boolean);

      const setActive = (activeHash) => {
        sections.forEach(({ link, hash }) => {
          const active = hash === activeHash;
          link.classList.toggle("is-active", active);
          if (active) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
      };

      if (sections.length > 0 && window.location.pathname === "/") {
        const spy = createActiveSectionScrollSpy({
          links: navLinks.map((link) => ({
            href: link.getAttribute("data-nav-link") || "",
          })),
          topnavRoot: root,
          onActiveChange: (hash) => {
            const cleanHash = hash.replace(/^#/, "");
            setActive(cleanHash);
            window.dispatchEvent(
              new CustomEvent("kersivo:active-section-change", {
                detail: { hash },
              })
            );
          },
        });
        spy.start();
      }

      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</header>
