  --scene-ivory-rgb: 244, 239, 229;
  --scene-steel-rgb: 152, 178, 196;
  --scene-shadow-rgb: 8, 10, 13;

  /* Focus */
  --focus: rgba(168, 194, 212, .78);
}
html{
  font-family: var(--font-sans);
