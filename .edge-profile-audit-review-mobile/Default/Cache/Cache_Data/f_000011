   ========================================= */

:root{
  --nav-h: 62px;
  --nav-pad: clamp(14px, 4vw, 20px);

  --neon-core: rgba(255,255,255,.95);
  --neon-a: rgba(190,145,255,.95);
  --neon-b: rgba(255,190,245,.85);
}

html{
  scroll-padding-top: calc(var(--nav-h) + env(safe-area-inset-top) + 14px);
}
html.k-navOpen { overflow: hidden; }

.k-topnav,
.k-topnav *{
  box-sizing: border-box;
}

.k-skip{
  position:absolute;
  left:-999px;
  top:8px;
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.16);
  color: rgba(255,255,255,.92);
  z-index: 999;
}
.k-skip:focus{ left: 12px; }

/* ===== HEADER ===== */
.k-topnav{
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 80;

  padding-top: env(safe-area-inset-top);
  padding-left:  calc(var(--nav-pad) + env(safe-area-inset-left));
  padding-right: calc(var(--nav-pad) + env(safe-area-inset-right));

  background: rgba(7,7,10,.10);
  border-bottom: 1px solid rgba(255,255,255,0);
  backdrop-filter: blur(0px);

  overflow: visible;
  transition: background 180ms ease, border-color 180ms ease, backdrop-filter 180ms ease;
}

.k-topnav.is-scrolled{
  background: rgba(7,7,10,.62);
  border-bottom-color: rgba(255,255,255,.08);
  backdrop-filter: blur(14px);
}

/* ===== INNER ===== */
.k-topnav__inner{
  width: min(1200px, 100%);
  margin: 0 auto;

  min-height: var(--nav-h);

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: 12px;
}

/* ===== BRAND ===== */
.k-topnav__brand{
  display:inline-flex;
  align-items:center;
  gap: 10px;
  color: rgba(255,255,255,.92);
  text-decoration:none;
  flex: 0 0 auto;
  min-width: 0;
}

