  box-shadow: none !important;
}

.k-mobileNav__close:active{ transform: translateY(1px); }

/* Content: NO scrolling, layout must fit */
.k-mobileNav__content{
  position: relative;
  z-index: 3;

  height: 100%;
  width: 100%;
  max-width: 100%;

  /* space for close button + bottom handle */
